---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AccoladePrize from '../../components/AccoladePrize.astro';
import { env } from 'cloudflare:workers';
import { getById } from '../../lib/db';
import { parseAccolades } from '../../lib/accolades';
import {
	externalRatingMeta,
	formatExternalRatingDisplay,
	parseExternalRatings,
} from '../../lib/external-ratings';
import { formatEditionPublished, formatExperiencedAt, formatGenreBrief, formatRating } from '../../lib/types';
import { DEFAULT_LOCALE, localizedPath, type Locale } from '../../i18n/locales';
import { t } from '../../i18n';
import {
	applyRecommendationTranslation,
	getRecommendationTranslation,
} from '../../lib/i18n-content';

interface Props {
	locale?: Locale;
}

export const prerender = false;

const locale: Locale = Astro.props.locale || (Astro.currentLocale as Locale) || DEFAULT_LOCALE;

const id = Astro.params.id!;
const rawItem = await getById(env.DB, id);
const published =
	rawItem && rawItem.published === 1 && (rawItem.type === 'movie' || rawItem.type === 'book');

const item = published && rawItem
	? applyRecommendationTranslation(
			rawItem,
			await getRecommendationTranslation(env.DB, rawItem.id, locale),
		)
	: rawItem;

if (!published) {
	Astro.response.status = 404;
}

const creatorLabel = item?.type === 'book' ? t(locale, 'recs.author') : t(locale, 'recs.director');
const whenLabel = item?.type === 'book' ? t(locale, 'recs.read') : t(locale, 'recs.watched');
const releaseLabel =
	item?.type === 'book' ? t(locale, 'recs.editionPublished') : t(locale, 'recs.released');
const originalLabel =
	item?.type === 'book' ? t(locale, 'recs.firstPublished') : t(locale, 'recs.released');
const coverKindKey = item?.type === 'book' ? 'recs.coverOf' : 'recs.posterOf';
const ratingText = item ? formatRating(item.rating) : null;
const whenText = item
	? formatExperiencedAt(item.experienced_at, { monthOnly: item.type === 'book' })
	: '';
const releaseText = item ? formatEditionPublished(item.edition_published_at) : '';
const originalText = item ? formatEditionPublished(item.original_published_at) : '';
const genreBrief = item ? formatGenreBrief(item.genre) : '';
const accoladeGroups = parseAccolades(item?.accolades);
const visibleGroups = accoladeGroups.slice(0, 2);
const extraGroups = accoladeGroups.slice(2);
const marketplaceRatings = parseExternalRatings(item?.external_ratings);
const synopsisSource = item?.type === 'movie' ? 'TMDB' : 'Open Library';
const moreInfoIsWikipedia = Boolean(item?.url && /wikipedia\.org/i.test(item.url));
const moreInfoLabel = moreInfoIsWikipedia ? t(locale, 'recs.wikipedia') : t(locale, 'recs.moreInfo');
const backType = item?.type === 'book' ? 'book' : 'movie';
const recsBase = localizedPath(locale, '/recommendations');
const backHref = `${recsBase}?type=${backType}`;
const moviesBack = `${recsBase}?type=movie`;
const disclaimerHref = localizedPath(locale, '/disclaimer');

function prizeRows(groups: typeof accoladeGroups) {
	return groups.flatMap((group) =>
		group.awards.map((award) => ({
			award,
			org: group.label,
			mark: group.mark,
		})),
	);
}

const visiblePrizes = prizeRows(visibleGroups);
const extraPrizes = prizeRows(extraGroups);
---

{
	!published || !item ? (
		<BaseLayout locale={locale} title={t(locale, 'recs.notFound')} robots="noindex, follow">
			<header class="section-head">
				<h1>{t(locale, 'recs.notFound')}</h1>
				<p>
					<a href={moviesBack}>{t(locale, 'recs.back')}</a>
				</p>
			</header>
		</BaseLayout>
	) : (
		<BaseLayout
			locale={locale}
			title={item.title}
			description={item.commentary?.trim() || item.summary}
			image={item.image_url || '/images/hero-ar.jpg'}
		>
			<p class="rec-detail__back">
				<a href={backHref}>
					{backType === 'book' ? t(locale, 'recs.allBooks') : t(locale, 'recs.allMovies')}
				</a>
			</p>

			<article class:list={['rec-detail', item.image_url && 'rec-detail--with-cover']}>
				{
					item.image_url && (
						<div class="rec-detail__media">
							<img
								src={item.image_url}
								alt={t(locale, coverKindKey, { title: item.title })}
								width="280"
								height="420"
								decoding="async"
							/>
						</div>
					)
				}

				<div class="rec-detail__body">
					{genreBrief && <p class="rec-item__meta">{genreBrief}</p>}
					<h1 class="rec-detail__title">{item.title}</h1>

					{
						ratingText && (
							<p
								class="rec-item__rating"
								aria-label={t(locale, 'recs.myRatingAria', { rating: ratingText })}
							>
								<span class="stars" aria-hidden="true">
									{'★'.repeat(Math.round(item.rating ?? 0))}
									{'☆'.repeat(Math.max(0, 5 - Math.round(item.rating ?? 0)))}
								</span>
								<span class="rec-item__rating-text">
									{ratingText}
									<span class="rec-item__rating-mine"> · {t(locale, 'recs.mine')}</span>
								</span>
							</p>
						)
					}

					{
						marketplaceRatings.length > 0 && (
							<div class="rec-marketplace">
								<p class="rec-marketplace__label">{t(locale, 'recs.elsewhere')}</p>
								<ul class="rec-marketplace__list">
									{marketplaceRatings.map((entry) => {
										const meta = externalRatingMeta(entry.source);
										const score = formatExternalRatingDisplay(entry);
										const href = entry.url || meta.home;
										return (
											<li>
												<a href={href} rel="noopener noreferrer" target="_blank">
													{entry.label}
													<span class="sr-only">
														{t(locale, 'recs.srRatingFor', { title: item.title })}
														{t(locale, 'recs.srNewTab')}
													</span>
												</a>
												<span class="rec-marketplace__score">{score}</span>
												{entry.count != null && entry.count > 0 && (
													<span class="rec-marketplace__count">
														{t(locale, 'recs.votes', {
															count: entry.count.toLocaleString(locale),
														})}
													</span>
												)}
											</li>
										);
									})}
								</ul>
								<p class="rec-marketplace__credit">
									{t(locale, 'recs.marketplaceCreditPre')}{' '}
									<a href={disclaimerHref}>{t(locale, 'recs.marketplaceCreditLink')}</a>.
								</p>
							</div>
						)
					}

					<ul class="rec-item__details">
						{item.type === 'book' && whenText && (
							<li>
								<strong>{whenLabel}:</strong> {whenText}
							</li>
						)}
						{item.director && (
							<li>
								<strong>{creatorLabel}:</strong> {item.director}
							</li>
						)}
						{item.type === 'movie' && item.cast_members && (
							<li>
								<strong>{t(locale, 'recs.cast')}:</strong> {item.cast_members}
							</li>
						)}
						{originalText && (
							<li>
								<strong>{originalLabel}:</strong> {originalText}
							</li>
						)}
						{releaseText && releaseText !== originalText && (
							<li>
								<strong>{releaseLabel}:</strong> {releaseText}
							</li>
						)}
						{releaseText && !originalText && (
							<li>
								<strong>{releaseLabel}:</strong> {releaseText}
							</li>
						)}
					</ul>

					<section class="rec-prose-block">
						<h2 class="rec-prose-block__label">{t(locale, 'recs.synopsis')}</h2>
						<p class="rec-prose-block__text">{item.summary}</p>
						<p class="rec-prose-block__source">
							{t(locale, 'recs.synopsisSource', { source: synopsisSource })}
						</p>
					</section>

					<section class="rec-prose-block rec-prose-block--personal">
						<h2 class="rec-prose-block__label">{t(locale, 'recs.commentary')}</h2>
						{
							item.commentary?.trim() ? (
								<p class="rec-prose-block__text">{item.commentary}</p>
							) : (
								<p class="rec-prose-block__text rec-prose-block__text--empty">
									{t(locale, 'recs.noCommentary')}
								</p>
							)
						}
					</section>

					{
						visiblePrizes.length > 0 && (
							<section class="rec-prizes">
								<h2 class="rec-prizes__heading">{t(locale, 'recs.awards')}</h2>
								<ul class="rec-prizes__list">
									{visiblePrizes.map((prize) => (
										<AccoladePrize award={prize.award} org={prize.org} mark={prize.mark} />
									))}
								</ul>
								{extraPrizes.length > 0 && (
									<details class="rec-prizes__more">
										<summary>
											{extraGroups.length === 1
												? t(locale, 'recs.moreInstitution', { n: extraGroups.length })
												: t(locale, 'recs.moreInstitutions', { n: extraGroups.length })}
										</summary>
										<ul class="rec-prizes__list">
											{extraPrizes.map((prize) => (
												<AccoladePrize
													award={prize.award}
													org={prize.org}
													mark={prize.mark}
												/>
											))}
										</ul>
									</details>
								)}
							</section>
						)
					}

					<div class="rec-item__links">
						{item.type === 'movie' && item.imdb_url && (
							<a
								class="rec-item__link"
								href={item.imdb_url}
								rel="noopener noreferrer"
								target="_blank"
							>
								IMDb
								<span class="sr-only">
									{t(locale, 'recs.srForTitle', { title: item.title })}{' '}
									{t(locale, 'recs.srNewTab')}
								</span>
							</a>
						)}
						{item.type === 'book' && item.goodreads_url && (
							<a
								class="rec-item__link"
								href={item.goodreads_url}
								rel="noopener noreferrer"
								target="_blank"
							>
								Goodreads
								<span class="sr-only">
									{t(locale, 'recs.srForTitle', { title: item.title })}{' '}
									{t(locale, 'recs.srNewTab')}
								</span>
							</a>
						)}
						{item.url && (
							<a
								class="rec-item__link"
								href={item.url}
								rel="noopener noreferrer"
								target="_blank"
							>
								{moreInfoLabel}
								<span class="sr-only">
									{t(locale, 'recs.srForTitle', { title: item.title })}{' '}
									{t(locale, 'recs.srNewTab')}
								</span>
							</a>
						)}
					</div>
				</div>
			</article>
		</BaseLayout>
	)
}
