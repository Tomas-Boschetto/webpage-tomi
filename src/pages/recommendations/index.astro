---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RecCard from '../../components/RecCard.astro';
import TripCard from '../../components/TripCard.astro';
import Planisphere from '../../components/Planisphere.astro';
import { env } from 'cloudflare:workers';
import { listPublished } from '../../lib/db';
import { listCountriesFromPublishedStops, listPublishedTripIdsForCountry } from '../../lib/countries';
import {
	extractActors,
	extractAuthors,
	extractDirectors,
	extractGenres,
	filterAndSortRecommendations,
	parseMinRating,
	parseRecSort,
	parseTripSort,
	sortTrips,
} from '../../lib/rec-filters';
import { coverSourceFromUrl } from '../../lib/covers';
import { accoladesSource, extractAccoladeInstitutions } from '../../lib/accolades';
import { listItineraryForTrip, listPublishedTrips } from '../../lib/trips';
import { isRecommendationType, type RecommendationType } from '../../lib/types';
import { DEFAULT_LOCALE, localizedPath, type Locale } from '../../i18n/locales';
import { t } from '../../i18n';
import { localizeRecommendations, localizeTrips } from '../../lib/i18n-content';

interface Props {
	locale?: Locale;
}

export const prerender = false;

const locale: Locale = Astro.props.locale || (Astro.currentLocale as Locale) || DEFAULT_LOCALE;

const typeParam = Astro.url.searchParams.get('type');
const showTravel = typeParam === 'travel';
const activeType: RecommendationType | undefined = isRecommendationType(typeParam)
	? typeParam
	: undefined;

// No combined “All” view — always land on a specific section.
if (!showTravel && !activeType) {
	const next = new URL(Astro.url);
	next.searchParams.set('type', 'movie');
	return Astro.redirect(`${next.pathname}?${next.searchParams.toString()}`);
}

const genreParam = Astro.url.searchParams.get('genre')?.trim() || '';
const awardParam = Astro.url.searchParams.get('award')?.trim() || '';
const authorParam = Astro.url.searchParams.get('author')?.trim() || '';
const directorParam = Astro.url.searchParams.get('director')?.trim() || '';
const actorParam = Astro.url.searchParams.get('actor')?.trim() || '';
const countryParam = Astro.url.searchParams.get('country')?.trim().toUpperCase() || '';
const sortParam = Astro.url.searchParams.get('sort');
const minRating = parseMinRating(Astro.url.searchParams.get('min_rating'));
const recSort = parseRecSort(sortParam);
const tripSort = parseTripSort(sortParam);

const allMediaRaw = showTravel ? [] : await listPublished(env.DB, activeType);
const allMedia = await localizeRecommendations(env.DB, allMediaRaw, locale);
const genres = extractGenres(allMedia);
const awardInstitutions = extractAccoladeInstitutions(allMedia);
const authors = activeType === 'book' ? extractAuthors(allMedia) : [];
const directors = activeType === 'movie' ? extractDirectors(allMedia) : [];
const actors = activeType === 'movie' ? extractActors(allMedia) : [];
const mediaItems = filterAndSortRecommendations(allMedia, {
	genre: genreParam || null,
	award: awardParam || null,
	author: authorParam || null,
	director: directorParam || null,
	actor: actorParam || null,
	minRating,
	sort: recSort,
});

const allTripsRaw = showTravel ? await listPublishedTrips(env.DB) : [];
const allTrips = showTravel ? await localizeTrips(env.DB, allTripsRaw, locale) : [];

const countries = showTravel ? await listCountriesFromPublishedStops(env.DB) : [];
const countryFilterValid =
	showTravel && countryParam.length === 2 && countries.some((c) => c.country_code === countryParam);

let rawTrips = allTrips;
if (showTravel && countryFilterValid) {
	const tripIds = await listPublishedTripIdsForCountry(env.DB, countryParam);
	rawTrips = allTrips.filter((trip) => tripIds.has(trip.id));
}

const trips = sortTrips(rawTrips, tripSort);

const tripCards = await Promise.all(
	trips.map(async (trip) => {
		const items = await listItineraryForTrip(env.DB, trip.id);
		const countryCodes = [
			...new Set(
				items
					.map((item) => item.country_code?.toUpperCase())
					.filter((code): code is string => Boolean(code)),
			),
		];
		return {
			trip,
			stopCount: items.length,
			countryCodes,
		};
	}),
);

const recsBase = localizedPath(locale, '/recommendations');
function hrefForType(type: 'movie' | 'book' | 'travel') {
	return `${recsBase}?type=${type}`;
}

const tabs = [
	{ label: t(locale, 'recs.movies'), href: hrefForType('movie'), current: activeType === 'movie' },
	{ label: t(locale, 'recs.books'), href: hrefForType('book'), current: activeType === 'book' },
	{ label: t(locale, 'recs.travel'), href: hrefForType('travel'), current: showTravel },
];

const empty = showTravel ? tripCards.length === 0 : mediaItems.length === 0;

const showMediaToolbar = !showTravel && allMedia.length > 0;
const showTravelToolbar = showTravel && allTrips.length > 0;

const coverSources = new Set(
	[
		...mediaItems.map((item) => coverSourceFromUrl(item.image_url)),
		...tripCards.map(({ trip }) => coverSourceFromUrl(trip.image_url)),
	].filter((source): source is 'tmdb' | 'openlibrary' | 'unsplash' => source != null),
);
const showTmdbCredit = coverSources.has('tmdb');
const showOpenLibraryCredit = coverSources.has('openlibrary');
const showUnsplashCredit = coverSources.has('unsplash');
const showWikidataCredit = mediaItems.some(
	(item) => accoladesSource(item.accolades) === 'wikidata',
);

const sectionBlurb = showTravel
	? t(locale, 'recs.blurb.travel')
	: activeType === 'book'
		? t(locale, 'recs.blurb.books')
		: t(locale, 'recs.blurb.movies');

const PAGE_SIZE = 10;
const hasMoreMedia = !showTravel && mediaItems.length > PAGE_SIZE;
const msgShowingMore = t(locale, 'recs.showingMore', { shown: '{shown}', total: '{total}' });
const msgShowingAll = t(locale, 'recs.showingAll', { total: '{total}' });
---

<BaseLayout
	locale={locale}
	title={t(locale, 'recs.title')}
	description={t(locale, 'recs.description')}
>
	<header class="section-head">
		<h1>{t(locale, 'recs.title')}</h1>
		<p>{sectionBlurb}</p>
	</header>

	<nav class="tabs" aria-label={t(locale, 'recs.tabs')}>
		{
			tabs.map((tab) => (
				<a href={tab.href} aria-current={tab.current ? 'page' : undefined}>
					{tab.label}
				</a>
			))
		}
	</nav>

	{
		showMediaToolbar && (
			<form class="rec-toolbar" method="get" id="rec-toolbar">
				{activeType && <input type="hidden" name="type" value={activeType} />}
				<label class="rec-toolbar__field">
					<span>{t(locale, 'recs.genre')}</span>
					<select name="genre">
						<option value="">{t(locale, 'recs.allGenres')}</option>
						{genres.map((genre) => (
							<option value={genre} selected={genreParam === genre}>
								{genre}
							</option>
						))}
					</select>
				</label>
				{
					activeType === 'book' && authors.length > 0 && (
						<label class="rec-toolbar__field">
							<span>{t(locale, 'recs.author')}</span>
							<select name="author">
								<option value="">{t(locale, 'recs.allAuthors')}</option>
								{authors.map((author) => (
									<option value={author} selected={authorParam === author}>
										{author}
									</option>
								))}
							</select>
						</label>
					)
				}
				{
					activeType === 'movie' && directors.length > 0 && (
						<label class="rec-toolbar__field">
							<span>{t(locale, 'recs.director')}</span>
							<select name="director">
								<option value="">{t(locale, 'recs.allDirectors')}</option>
								{directors.map((director) => (
									<option value={director} selected={directorParam === director}>
										{director}
									</option>
								))}
							</select>
						</label>
					)
				}
				{
					activeType === 'movie' && actors.length > 0 && (
						<label class="rec-toolbar__field">
							<span>{t(locale, 'recs.actor')}</span>
							<select name="actor">
								<option value="">{t(locale, 'recs.allActors')}</option>
								{actors.map((actor) => (
									<option value={actor} selected={actorParam === actor}>
										{actor}
									</option>
								))}
							</select>
						</label>
					)
				}
				{
					awardInstitutions.length > 0 && (
						<label class="rec-toolbar__field">
							<span>{t(locale, 'recs.award')}</span>
							<select name="award">
								<option value="">{t(locale, 'recs.allAwards')}</option>
								{awardInstitutions.map((institution) => (
									<option value={institution} selected={awardParam === institution}>
										{institution}
									</option>
								))}
							</select>
						</label>
					)
				}
				<label class="rec-toolbar__field">
					<span>{t(locale, 'recs.minRating')}</span>
					<select name="min_rating">
						<option value="" selected={minRating == null}>
							{t(locale, 'recs.any')}
						</option>
						{[3, 3.5, 4, 4.5, 5].map((value) => (
							<option value={String(value)} selected={minRating === value}>
								{value}+
							</option>
						))}
					</select>
				</label>
				<label class="rec-toolbar__field">
					<span>{t(locale, 'recs.sort')}</span>
					<select name="sort">
						<option value="newest" selected={recSort === 'newest'}>
							{t(locale, 'recs.sortNewest')}
						</option>
						<option value="oldest" selected={recSort === 'oldest'}>
							{t(locale, 'recs.sortOldest')}
						</option>
						<option value="rating-desc" selected={recSort === 'rating-desc'}>
							{t(locale, 'recs.sortRatingDesc')}
						</option>
						<option value="rating-asc" selected={recSort === 'rating-asc'}>
							{t(locale, 'recs.sortRatingAsc')}
						</option>
						<option value="title-asc" selected={recSort === 'title-asc'}>
							{t(locale, 'recs.sortTitleAsc')}
						</option>
						<option value="title-desc" selected={recSort === 'title-desc'}>
							{t(locale, 'recs.sortTitleDesc')}
						</option>
					</select>
				</label>
			</form>
		)
	}

	{
		showTravelToolbar && (
			<form class="rec-toolbar" method="get" id="rec-toolbar">
				<input type="hidden" name="type" value="travel" />
				<label class="rec-toolbar__field">
					<span>{t(locale, 'recs.country')}</span>
					<select name="country">
						<option value="">{t(locale, 'recs.allCountries')}</option>
						{countries.map((country) => (
							<option
								value={country.country_code}
								selected={countryFilterValid && countryParam === country.country_code}
							>
								{country.name}
							</option>
						))}
					</select>
				</label>
				<label class="rec-toolbar__field">
					<span>{t(locale, 'recs.sort')}</span>
					<select name="sort">
						<option value="newest" selected={tripSort === 'newest'}>
							{t(locale, 'recs.sortNewest')}
						</option>
						<option value="oldest" selected={tripSort === 'oldest'}>
							{t(locale, 'recs.sortOldest')}
						</option>
						<option value="title-asc" selected={tripSort === 'title-asc'}>
							{t(locale, 'recs.sortTitleAsc')}
						</option>
						<option value="title-desc" selected={tripSort === 'title-desc'}>
							{t(locale, 'recs.sortTitleDesc')}
						</option>
					</select>
				</label>
			</form>
		)
	}

	{
		empty ? (
			<p class="empty">{t(locale, 'recs.empty')}</p>
		) : showTravel ? (
			<section class="travel-split" data-travel-split>
				<div class="travel-split__list" data-travel-list>
					<div class="rec-list travel-split__cards">
						{tripCards.map(({ trip, stopCount, countryCodes }) => (
							<TripCard
								trip={trip}
								stopCount={stopCount}
								countryCodes={countryCodes}
								locale={locale}
							/>
						))}
					</div>
					<p class="travel-split__empty empty" data-travel-empty hidden>
						{t(locale, 'recs.emptyCountry')}
					</p>
				</div>
				<div class="travel-split__map">
					<Planisphere countries={countries} id="travel-planisphere" locale={locale} />
				</div>
			</section>
		) : (
			<>
				<div
					class="rec-list"
					data-rec-infinite
					data-page-size={PAGE_SIZE}
					data-msg-more={msgShowingMore}
					data-msg-all={msgShowingAll}
				>
					{mediaItems.map((item, index) => (
						<RecCard item={item} deferred={index >= PAGE_SIZE} locale={locale} />
					))}
					{hasMoreMedia && (
						<div class="rec-infinite-sentinel" data-rec-sentinel aria-hidden="true"></div>
					)}
				</div>
				<p class="rec-infinite-status sr-only" data-rec-status role="status" aria-live="polite"></p>
				{(showTmdbCredit || showOpenLibraryCredit || showUnsplashCredit || showWikidataCredit) && (
					<p class="rec-attribution">
						{showTmdbCredit && (
							<>
								{t(locale, 'recs.attr.tmdbPre')}{' '}
								<a href="https://www.themoviedb.org/" rel="noopener noreferrer" target="_blank">
									TMDB
									<span class="sr-only"> {t(locale, 'footer.newTab')}</span>
								</a>
								{t(locale, 'recs.attr.tmdbPost')}
								{showOpenLibraryCredit || showUnsplashCredit || showWikidataCredit ? ' ' : ''}
							</>
						)}
						{showOpenLibraryCredit && (
							<>
								{t(locale, 'recs.attr.openLibraryPre')}{' '}
								<a href="https://openlibrary.org/" rel="noopener noreferrer" target="_blank">
									Open Library
									<span class="sr-only"> {t(locale, 'footer.newTab')}</span>
								</a>
								.
								{showUnsplashCredit || showWikidataCredit ? ' ' : ''}
							</>
						)}
						{showUnsplashCredit && (
							<>
								{t(locale, 'recs.attr.unsplashPre')}{' '}
								<a href="https://unsplash.com/?utm_source=tomasboschetto&utm_medium=referral" rel="noopener noreferrer" target="_blank">
									Unsplash
									<span class="sr-only"> {t(locale, 'footer.newTab')}</span>
								</a>
								.
								{showWikidataCredit ? ' ' : ''}
							</>
						)}
						{showWikidataCredit && (
							<>
								{t(locale, 'recs.attr.wikidataPre')}{' '}
								<a href="https://www.wikidata.org/" rel="noopener noreferrer" target="_blank">
									Wikidata
									<span class="sr-only"> {t(locale, 'footer.newTab')}</span>
								</a>{' '}
								{t(locale, 'recs.attr.wikidataPost')}
							</>
						)}
					</p>
				)}
			</>
		)
	}

	{
		showTravel && showUnsplashCredit && (
			<p class="rec-attribution">
				{t(locale, 'recs.attr.unsplashPre')}{' '}
				<a href="https://unsplash.com/?utm_source=tomasboschetto&utm_medium=referral" rel="noopener noreferrer" target="_blank">
					Unsplash
					<span class="sr-only"> {t(locale, 'footer.newTab')}</span>
				</a>
				.
			</p>
		)
	}
</BaseLayout>

<script>
	const form = document.getElementById('rec-toolbar');
	form?.querySelectorAll('select').forEach((select) => {
		select.addEventListener('change', () => {
			if (form instanceof HTMLFormElement) form.requestSubmit();
		});
	});

	const infiniteList = document.querySelector('[data-rec-infinite]');
	if (infiniteList instanceof HTMLElement) {
		const pageSize = Math.max(1, Number(infiniteList.dataset.pageSize) || 10);
		const msgMoreTpl = infiniteList.dataset.msgMore || 'Showing {shown} of {total}. Scroll for more.';
		const msgAllTpl = infiniteList.dataset.msgAll || 'Showing all {total}.';
		const items = Array.from(infiniteList.querySelectorAll(':scope > .rec-item'));
		const sentinel = infiniteList.querySelector('[data-rec-sentinel]');
		const statusEl = document.querySelector('[data-rec-status]');
		let shown = items.filter((el) => !el.hasAttribute('hidden')).length;

		function formatStatus(tpl, vars) {
			return String(tpl)
				.replaceAll('{shown}', String(vars.shown))
				.replaceAll('{total}', String(vars.total));
		}

		function setStatus(message) {
			if (statusEl instanceof HTMLElement) statusEl.textContent = message;
		}

		function revealMore() {
			const next = items.slice(shown, shown + pageSize);
			if (!next.length) return;
			next.forEach((el) => el.removeAttribute('hidden'));
			shown += next.length;
			const remaining = items.length - shown;
			setStatus(
				remaining > 0
					? formatStatus(msgMoreTpl, { shown, total: items.length })
					: formatStatus(msgAllTpl, { total: items.length }),
			);
			if (remaining <= 0) {
				observer.disconnect();
				sentinel?.remove();
			}
		}

		const observer = new IntersectionObserver(
			(entries) => {
				if (entries.some((entry) => entry.isIntersecting)) revealMore();
			},
			{ root: null, rootMargin: '280px 0px', threshold: 0 },
		);

		if (sentinel && shown < items.length) {
			observer.observe(sentinel);
			setStatus(formatStatus(msgMoreTpl, { shown, total: items.length }));
		}
	}

	const split = document.querySelector('[data-travel-split]');
	if (split) {
		const list = split.querySelector('[data-travel-list]');
		const emptyEl = split.querySelector('[data-travel-empty]');
		const cards = Array.from(split.querySelectorAll('[data-trip-card]'));
		const mapRoot = split.querySelector('[data-planisphere-map]');
		const legend = split.querySelector('[data-planisphere-legend]');
		const mapColumn = split.querySelector('.travel-split__map');

		function syncListHeight() {
			if (!(list instanceof HTMLElement) || !(mapColumn instanceof HTMLElement)) return;
			if (window.matchMedia('(max-width: 899px)').matches) {
				list.style.maxHeight = '';
				return;
			}
			list.style.maxHeight = `${Math.max(mapColumn.offsetHeight, 240)}px`;
		}

		if (mapColumn && 'ResizeObserver' in window) {
			new ResizeObserver(() => syncListHeight()).observe(mapColumn);
		}
		window.addEventListener('resize', syncListHeight);
		syncListHeight();

		function applyCountryFilter(code) {
			const normalized = code ? String(code).toUpperCase() : '';
			let visible = 0;
			cards.forEach((card) => {
				const countries = String(card.getAttribute('data-countries') || '')
					.split(',')
					.map((c) => c.trim().toUpperCase())
					.filter(Boolean);
				const show = !normalized || countries.includes(normalized);
				card.hidden = !show;
				if (show) visible += 1;
			});
			if (emptyEl instanceof HTMLElement) {
				emptyEl.hidden = visible > 0;
			}
			mapRoot?.querySelectorAll('path.country.is-visited').forEach((path) => {
				path.classList.toggle('is-hover-filter', Boolean(normalized) && path.id === normalized);
			});
			legend?.querySelectorAll('[data-legend-code]').forEach((row) => {
				row.classList.toggle(
					'is-hover-filter',
					Boolean(normalized) && row.getAttribute('data-legend-code') === normalized,
				);
			});
		}

		function clearHoverFilter() {
			applyCountryFilter('');
		}

		mapRoot?.querySelectorAll('path.country.is-visited').forEach((path) => {
			path.addEventListener('mouseenter', () => applyCountryFilter(path.id));
			path.addEventListener('mouseleave', clearHoverFilter);
			path.addEventListener('focus', () => applyCountryFilter(path.id));
			path.addEventListener('blur', clearHoverFilter);
			if (!path.hasAttribute('tabindex')) path.setAttribute('tabindex', '0');
		});

		legend?.querySelectorAll('[data-legend-code]').forEach((row) => {
			row.addEventListener('mouseenter', () =>
				applyCountryFilter(row.getAttribute('data-legend-code')),
			);
			row.addEventListener('mouseleave', clearHoverFilter);
			row.addEventListener('focus', () =>
				applyCountryFilter(row.getAttribute('data-legend-code')),
			);
			row.addEventListener('blur', clearHoverFilter);
		});
	}
</script>
