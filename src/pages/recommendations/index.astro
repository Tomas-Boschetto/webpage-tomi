---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RecCard from '../../components/RecCard.astro';
import TripCard from '../../components/TripCard.astro';
import Planisphere from '../../components/Planisphere.astro';
import { env } from 'cloudflare:workers';
import { listPublished } from '../../lib/db';
import { listCountriesFromPublishedStops } from '../../lib/countries';
import { listItineraryForTrip, listPublishedTrips } from '../../lib/trips';
import { isRecommendationType, type RecommendationType } from '../../lib/types';

export const prerender = false;

const typeParam = Astro.url.searchParams.get('type');
const showTravel = typeParam === 'travel';
const activeType: RecommendationType | undefined = isRecommendationType(typeParam)
	? typeParam
	: undefined;

const mediaItems = showTravel ? [] : await listPublished(env.DB, activeType);
const trips = !activeType || showTravel ? await listPublishedTrips(env.DB) : [];
const countries = showTravel ? await listCountriesFromPublishedStops(env.DB) : [];

const tripCards = await Promise.all(
	trips.map(async (trip) => ({
		trip,
		stopCount: (await listItineraryForTrip(env.DB, trip.id)).length,
	})),
);

const tabs = [
	{ label: 'All', href: '/recommendations', current: !typeParam },
	{ label: 'Movies', href: '/recommendations?type=movie', current: activeType === 'movie' },
	{ label: 'Books', href: '/recommendations?type=book', current: activeType === 'book' },
	{ label: 'Travel', href: '/recommendations?type=travel', current: showTravel },
];

const empty =
	!showTravel && mediaItems.length === 0 && tripCards.length === 0;
---

<BaseLayout title="Recommendations" description="Movie, book, and travel recommendations.">
	<header class="section-head">
		<h1>{showTravel ? 'Travel' : 'Recommendations'}</h1>
		<p>
			{
				showTravel
					? 'Countries from your trip stops on the planisphere, then individual trips.'
					: 'Newest first. Filter by type, or browse everything.'
			}
		</p>
	</header>

	<nav class="tabs" aria-label="Recommendation types">
		{
			tabs.map((tab) => (
				<a href={tab.href} aria-current={tab.current ? 'true' : undefined}>
					{tab.label}
				</a>
			))
		}
	</nav>

	{showTravel && <Planisphere countries={countries} />}

	{
		showTravel ? (
			<section class="travel-trips">
				<header class="section-head section-head--compact">
					<h2>Trips</h2>
					<p>Open a trip for its map and itinerary.</p>
				</header>
				{tripCards.length === 0 ? (
					<p class="empty">No trips published yet.</p>
				) : (
					<div class="rec-list">
						{tripCards.map(({ trip, stopCount }) => (
							<TripCard trip={trip} stopCount={stopCount} />
						))}
					</div>
				)}
			</section>
		) : empty ? (
			<p class="empty">Nothing published here yet. Check back soon.</p>
		) : (
			<div class="rec-list">
				{mediaItems.map((item) => (
					<RecCard item={item} />
				))}
				{tripCards.map(({ trip, stopCount }) => (
					<TripCard trip={trip} stopCount={stopCount} />
				))}
			</div>
		)
	}
</BaseLayout>
