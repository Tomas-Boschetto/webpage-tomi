---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TripMap from '../../components/TripMap.astro';
import { env } from 'cloudflare:workers';
import { formatVisitedAt, getTripWithItems } from '../../lib/trips';
import { isTransportMode } from '../../lib/types';
import { DEFAULT_LOCALE, localizedPath, type Locale } from '../../i18n/locales';
import { t, placeTypeLabel, transportModeLabel } from '../../i18n';
import { localizeTripWithItems } from '../../lib/i18n-content';

interface Props {
	locale?: Locale;
}

export const prerender = false;

const locale: Locale = Astro.props.locale || (Astro.currentLocale as Locale) || DEFAULT_LOCALE;

const rawTrip = await getTripWithItems(env.DB, Astro.params.id!, { publishedOnly: true });
const trip = rawTrip ? await localizeTripWithItems(env.DB, rawTrip, locale) : null;

if (!trip) {
	Astro.response.status = 404;
}

const travelHref = `${localizedPath(locale, '/recommendations')}?type=travel`;
---

{
	!trip ? (
		<BaseLayout locale={locale} title={t(locale, 'trip.notFound')} robots="noindex, follow">
			<header class="section-head">
				<h1>{t(locale, 'trip.notFound')}</h1>
				<p>
					<a href={travelHref}>{t(locale, 'trip.back')}</a>
				</p>
			</header>
		</BaseLayout>
	) : (
		<BaseLayout
			locale={locale}
			title={trip.title}
			description={trip.summary}
			image={trip.image_url || '/images/hero-ar.jpg'}
		>
			<header class="section-head">
				<h1>{trip.title}</h1>
				<p>{trip.summary}</p>
				<p>
					<a href={travelHref}>{t(locale, 'trip.allTrips')}</a>
				</p>
			</header>

			<TripMap items={trip.items} tripTitle={trip.title} locale={locale} />

			{
				trip.items.length === 0 ? (
					<p class="empty">{t(locale, 'trip.emptyStops')}</p>
				) : (
					<ol class="itinerary">
						{trip.items.map((item, index) => {
							const hasPhoto = Boolean(item.image_url);
							const mode = isTransportMode(item.transport_mode)
								? item.transport_mode
								: 'other';
							const modeLabel = transportModeLabel(locale, mode);
							const transitDetail = item.how_i_got_there?.trim() || '';
							return (
								<li
									class:list={['itinerary__item', hasPhoto && 'itinerary__item--with-photo']}
									id={`stop-${item.id}`}
									tabindex="-1"
									data-stop-id={item.lat != null && item.lng != null ? item.id : undefined}
								>
									<div class="itinerary__head">
										<span class="badge">{placeTypeLabel(locale, item.place_type)}</span>
										<h2 class="itinerary__place">{item.place_name}</h2>
									</div>
									<div class="itinerary__body">
										<div class="itinerary__copy">
											{item.visited_at && (
												<p class="itinerary__when">
													<strong>{t(locale, 'trip.visited')}:</strong>{' '}
													{formatVisitedAt(item.visited_at, locale)}
												</p>
											)}
											{index > 0 && (
												<p class="itinerary__transit">
													<strong>{t(locale, 'trip.howGotThere')}:</strong> {modeLabel}
													{transitDetail ? ` — ${transitDetail}` : ''}
												</p>
											)}
											{index === 0 && transitDetail && (
												<p class="itinerary__transit">
													<strong>{t(locale, 'trip.arrivalNotes')}:</strong>{' '}
													{transitDetail}
												</p>
											)}
											{item.lat != null && item.lng != null && (
												<p class="itinerary__coords">
													<button type="button" class="linkish" data-stop-id={item.id}>
														{t(locale, 'trip.showOnMap')}
													</button>
													{' · '}
													<a
														class="linkish"
														href={`https://www.google.com/maps/search/?api=1&query=${item.lat},${item.lng}`}
														rel="noopener noreferrer"
														target="_blank"
													>
														{t(locale, 'trip.openMaps')}
														<span class="sr-only"> {t(locale, 'footer.newTab')}</span>
													</a>
												</p>
											)}
											{item.notes && <p class="itinerary__notes">{item.notes}</p>}
											{item.url && (
												<p class="itinerary__link-wrap">
													<a
														class="rec-item__link"
														href={item.url}
														rel="noopener noreferrer"
														target="_blank"
													>
														{t(locale, 'trip.link')}
														<span class="sr-only"> {t(locale, 'footer.newTab')}</span>
													</a>
												</p>
											)}
										</div>
										{hasPhoto && (
											<figure class="itinerary__photo">
												<img
													src={item.image_url!}
													alt={t(locale, 'trip.photoAlt', { place: item.place_name })}
													loading="lazy"
													decoding="async"
													width="640"
													height="427"
												/>
											</figure>
										)}
									</div>
								</li>
							);
						})}
					</ol>
				)
			}
		</BaseLayout>
	)
}
