---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TripMap from '../../components/TripMap.astro';
import { env } from 'cloudflare:workers';
import { formatVisitedAt, getTripWithItems } from '../../lib/trips';
import { PLACE_TYPE_LABELS } from '../../lib/types';

export const prerender = false;

const trip = await getTripWithItems(env.DB, Astro.params.id!, { publishedOnly: true });

if (!trip) {
	Astro.response.status = 404;
}
---

{
	!trip ? (
		<BaseLayout title="Trip not found" robots="noindex, follow">
			<header class="section-head">
				<h1>Trip not found</h1>
				<p>
					<a href="/recommendations?type=travel">Back to travel</a>
				</p>
			</header>
		</BaseLayout>
	) : (
		<BaseLayout
			title={trip.title}
			description={trip.summary}
			image={trip.image_url || '/images/hero-ar.jpg'}
		>
			<header class="section-head">
				<p class="rec-item__meta">Trip</p>
				<h1>{trip.title}</h1>
				<p>{trip.summary}</p>
				<p>
					<a href="/recommendations?type=travel">← All trips</a>
				</p>
			</header>

			<TripMap items={trip.items} />

			{
				trip.items.length === 0 ? (
					<p class="empty">No itinerary stops published for this trip yet.</p>
				) : (
					<ol class="itinerary">
						{trip.items.map((item) => {
							const hasPhoto = Boolean(item.image_url);
							return (
								<li
									class:list={['itinerary__item', hasPhoto && 'itinerary__item--with-photo']}
									id={`stop-${item.id}`}
									data-stop-id={item.lat != null && item.lng != null ? item.id : undefined}
								>
									<div class="itinerary__head">
										<span class="badge">{PLACE_TYPE_LABELS[item.place_type]}</span>
										<h2 class="itinerary__place">{item.place_name}</h2>
									</div>
									<div class="itinerary__body">
										<div class="itinerary__copy">
											{item.visited_at && (
												<p class="itinerary__when">
													<strong>Visited:</strong> {formatVisitedAt(item.visited_at)}
												</p>
											)}
											<p class="itinerary__transit">
												<strong>How I got there:</strong> {item.how_i_got_there}
											</p>
											{item.lat != null && item.lng != null && (
												<p class="itinerary__coords">
													<button type="button" class="linkish" data-stop-id={item.id}>
														Show on map
													</button>
												</p>
											)}
											{item.notes && <p class="itinerary__notes">{item.notes}</p>}
											{item.url && (
												<p class="itinerary__link-wrap">
													<a
														class="rec-item__link"
														href={item.url}
														rel="noopener noreferrer"
														target="_blank"
													>
														Link
													</a>
												</p>
											)}
										</div>
										{hasPhoto && (
											<figure class="itinerary__photo">
												<img
													src={item.image_url!}
													alt={`Photo from ${item.place_name}`}
													loading="lazy"
													decoding="async"
													width="640"
													height="427"
												/>
											</figure>
										)}
									</div>
								</li>
							);
						})}
					</ol>
				)
			}
		</BaseLayout>
	)
}
