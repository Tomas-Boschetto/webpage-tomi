---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TripMap from '../../components/TripMap.astro';
import ItineraryStops from '../../components/ItineraryStops.astro';
import { env } from 'cloudflare:workers';
import { getTripWithItems } from '../../lib/trips';
import { parseCountryCode, uniqueTripCountries } from '../../lib/countries';
import { DEFAULT_LOCALE, localizedPath, stripLocalePrefix, type Locale } from '../../i18n/locales';
import { t } from '../../i18n';
import { localizeTripWithItems } from '../../lib/i18n-content';
import TripFlags from '../../components/TripFlags.astro';

interface Props {
	locale?: Locale;
}

export const prerender = false;

const locale: Locale = Astro.props.locale || (Astro.currentLocale as Locale) || DEFAULT_LOCALE;

const rawTrip = await getTripWithItems(env.DB, Astro.params.id!, { publishedOnly: true });
const trip = rawTrip ? await localizeTripWithItems(env.DB, rawTrip, locale) : null;

if (!trip) {
	Astro.response.status = 404;
}

function countryFromReferer(referer: string | null): string {
	if (!referer) return '';
	try {
		const ref = new URL(referer);
		if (stripLocalePrefix(ref.pathname) !== '/recommendations') return '';
		return parseCountryCode(ref.searchParams.get('country'));
	} catch {
		return '';
	}
}

const travelCountry =
	parseCountryCode(Astro.url.searchParams.get('country')) ||
	countryFromReferer(Astro.request.headers.get('referer'));
const travelHref = travelCountry
	? `${localizedPath(locale, '/recommendations')}?type=travel&country=${travelCountry}`
	: `${localizedPath(locale, '/recommendations')}?type=travel`;
const hasMap =
	Boolean(trip) && trip!.items.some((item) => item.lat != null && item.lng != null);
const tripCountries = trip ? uniqueTripCountries(trip.items) : [];
---

{
	!trip ? (
		<BaseLayout locale={locale} title={t(locale, 'trip.notFound')} robots="noindex, follow">
			<header class="section-head">
				<h1>{t(locale, 'trip.notFound')}</h1>
				<p>
					<a href={travelHref} data-travel-back>{t(locale, 'trip.back')}</a>
				</p>
			</header>
		</BaseLayout>
	) : (
		<BaseLayout
			locale={locale}
			title={trip.title}
			description={trip.summary}
			image={trip.image_url || '/images/hero-ar.jpg'}
		>
			<header class="trip-hero">
				<div class="trip-hero__copy">
					<h1>{trip.title}</h1>
					<TripFlags countries={tripCountries} locale={locale} />
					<p class="trip-hero__summary">{trip.summary}</p>
					<p class="trip-hero__back">
						<a href={travelHref} data-travel-back>{t(locale, 'trip.allTrips')}</a>
					</p>
				</div>
			</header>

			{
				trip.items.length === 0 ? (
					<p class="empty">{t(locale, 'trip.emptyStops')}</p>
				) : hasMap ? (
					<section class="itinerary-split">
						<div class="itinerary-split__list" data-itinerary-list>
							<ItineraryStops items={trip.items} locale={locale} />
						</div>
						<div class="itinerary-split__map">
							<TripMap items={trip.items} tripTitle={trip.title} locale={locale} compact />
						</div>
					</section>
				) : (
					<section class="trip-itinerary" data-itinerary-list>
						<ItineraryStops items={trip.items} locale={locale} />
					</section>
				)
			}
		</BaseLayout>
	)
}

<script is:inline>
	(function () {
		try {
			var code = sessionStorage.getItem('recs-travel-country') || '';
			if (!/^[A-Za-z]{2}$/.test(code)) return;
			code = code.toUpperCase();
			document.querySelectorAll('a[href*="type=travel"]').forEach(function (a) {
				var url = new URL(a.href, window.location.origin);
				if (url.pathname.indexOf('/recommendations') === -1) return;
				url.searchParams.set('country', code);
				a.setAttribute('href', url.pathname + url.search + url.hash);
			});
		} catch (e) {}
	})();
</script>
