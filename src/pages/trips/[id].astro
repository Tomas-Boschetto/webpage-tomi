---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TripMap from '../../components/TripMap.astro';
import ItineraryStops from '../../components/ItineraryStops.astro';
import { env } from 'cloudflare:workers';
import { getTripWithItems } from '../../lib/trips';
import { DEFAULT_LOCALE, localizedPath, type Locale } from '../../i18n/locales';
import { t } from '../../i18n';
import { localizeTripWithItems } from '../../lib/i18n-content';

interface Props {
	locale?: Locale;
}

export const prerender = false;

const locale: Locale = Astro.props.locale || (Astro.currentLocale as Locale) || DEFAULT_LOCALE;

const rawTrip = await getTripWithItems(env.DB, Astro.params.id!, { publishedOnly: true });
const trip = rawTrip ? await localizeTripWithItems(env.DB, rawTrip, locale) : null;

if (!trip) {
	Astro.response.status = 404;
}

const travelHref = `${localizedPath(locale, '/recommendations')}?type=travel`;
const hasMap =
	Boolean(trip) && trip!.items.some((item) => item.lat != null && item.lng != null);
---

{
	!trip ? (
		<BaseLayout locale={locale} title={t(locale, 'trip.notFound')} robots="noindex, follow">
			<header class="section-head">
				<h1>{t(locale, 'trip.notFound')}</h1>
				<p>
					<a href={travelHref}>{t(locale, 'trip.back')}</a>
				</p>
			</header>
		</BaseLayout>
	) : (
		<BaseLayout
			locale={locale}
			title={trip.title}
			description={trip.summary}
			image={trip.image_url || '/images/hero-ar.jpg'}
		>
			<header class="section-head">
				<h1>{trip.title}</h1>
				<p>{trip.summary}</p>
				<p>
					<a href={travelHref}>{t(locale, 'trip.allTrips')}</a>
				</p>
			</header>

			{
				trip.items.length === 0 ? (
					<p class="empty">{t(locale, 'trip.emptyStops')}</p>
				) : hasMap ? (
					<section class="itinerary-split" data-itinerary-split>
						<div class="itinerary-split__list" data-itinerary-list>
							<ItineraryStops items={trip.items} locale={locale} />
						</div>
						<div class="itinerary-split__map">
							<TripMap items={trip.items} tripTitle={trip.title} locale={locale} />
						</div>
					</section>
				) : (
					<ItineraryStops items={trip.items} locale={locale} />
				)
			}
		</BaseLayout>
	)
}
