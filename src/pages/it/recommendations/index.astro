---
import Recs from '../../recommendations/index.astro';
import type { Locale } from '../../../i18n/locales';
import { recommendationsTypeRedirect } from '../../../lib/site';
export const prerender = false;
const locale = Astro.currentLocale as Locale;
const recsRedirect = recommendationsTypeRedirect(Astro.url);
if (recsRedirect) {
	return Astro.redirect(recsRedirect, 301);
}
---
<Recs locale={locale} />
