---
import BaseLayout from '../layouts/BaseLayout.astro';
import { DEFAULT_LOCALE, type Locale } from '../i18n/locales';
import { t } from '../i18n';

interface Props {
	locale?: Locale;
}

export const prerender = false;

const locale: Locale = Astro.props.locale || (Astro.currentLocale as Locale) || DEFAULT_LOCALE;
---

<BaseLayout
	locale={locale}
	title={t(locale, 'about.title')}
	description={t(locale, 'about.description')}
>
	<header class="section-head">
		<h1>{t(locale, 'about.title')}</h1>
	</header>

	<article class="about-prose">
		<p>{t(locale, 'about.p1')}</p>
		<p>{t(locale, 'about.p2')}</p>
		<p>{t(locale, 'about.p3')}</p>
	</article>
</BaseLayout>
