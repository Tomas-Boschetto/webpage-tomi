---
import BaseLayout from '../layouts/BaseLayout.astro';
import { env } from 'cloudflare:workers';
import { DEFAULT_LOCALE, type Locale } from '../i18n/locales';
import { t } from '../i18n';

interface Props {
	locale?: Locale;
}

export const prerender = false;

const locale: Locale = Astro.props.locale || (Astro.currentLocale as Locale) || DEFAULT_LOCALE;
const linkedIn = env.LINKEDIN_URL || 'https://www.linkedin.com/in/tomasboschetto/';
const siteKey = env.TURNSTILE_SITE_KEY || '';
const msgSending = t(locale, 'contact.sending');
const msgSent = t(locale, 'contact.sent');
const msgError = t(locale, 'contact.error');
const msgNetwork = t(locale, 'contact.network');
---

<BaseLayout
	locale={locale}
	title={t(locale, 'contact.title')}
	description={t(locale, 'contact.description')}
>
	<header class="section-head">
		<h1>{t(locale, 'contact.title')}</h1>
		<p>{t(locale, 'contact.lead')}</p>
	</header>

	<form
		class="form"
		id="contact-form"
		novalidate
		data-msg-sending={msgSending}
		data-msg-sent={msgSent}
		data-msg-error={msgError}
		data-msg-network={msgNetwork}
	>
		<label>
			{t(locale, 'contact.name')}
			<input type="text" name="name" required maxlength="120" autocomplete="name" aria-required="true" />
		</label>
		<label>
			{t(locale, 'contact.email')}
			<input type="email" name="email" required maxlength="200" autocomplete="email" aria-required="true" />
		</label>
		<label>
			{t(locale, 'contact.message')}
			<textarea name="message" required maxlength="4000" aria-required="true"></textarea>
		</label>

		{
			siteKey ? (
				<div
					class="cf-turnstile"
					data-sitekey={siteKey}
					data-theme="dark"
					data-appearance="interaction-only"
				/>
			) : null
		}

		<div class="form__actions">
			<button class="btn btn--primary" type="submit">{t(locale, 'contact.send')}</button>
			<p class="form__status" id="contact-status" role="status" aria-live="polite"></p>
		</div>
	</form>

	<aside class="contact-aside">
		<p>
			{t(locale, 'contact.prefer')}{' '}
			<a href={linkedIn} rel="noopener noreferrer" target="_blank"
				>{t(locale, 'contact.follow')}<span class="sr-only">
					{' '}
					{t(locale, 'footer.newTab')}</span
				></a
			>.
		</p>
	</aside>
</BaseLayout>

{
	siteKey && (
		<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer />
	)
}

<script>
	const form = document.getElementById('contact-form') as HTMLFormElement | null;
	const statusEl = document.getElementById('contact-status');

	form?.addEventListener('submit', async (event) => {
		event.preventDefault();
		if (!statusEl || !form) return;

		statusEl.className = 'form__status';
		statusEl.textContent = form.dataset.msgSending || 'Sending…';

		const data = new FormData(form);
		const turnstileInput = form.querySelector(
			'[name="cf-turnstile-response"]',
		) as HTMLInputElement | null;

		const payload = {
			name: String(data.get('name') || ''),
			email: String(data.get('email') || ''),
			message: String(data.get('message') || ''),
			turnstileToken: turnstileInput?.value || '',
		};

		try {
			const res = await fetch('/api/contact', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify(payload),
			});
			const json = (await res.json()) as { error?: string; ok?: boolean };

			if (!res.ok) {
				statusEl.className = 'form__status form__status--err';
				statusEl.textContent = json.error || form.dataset.msgError || 'Something went wrong.';
				return;
			}

			statusEl.className = 'form__status form__status--ok';
			statusEl.textContent = form.dataset.msgSent || 'Message sent.';
			form.reset();
		} catch {
			statusEl.className = 'form__status form__status--err';
			statusEl.textContent = form.dataset.msgNetwork || 'Network error.';
		}
	});
</script>
