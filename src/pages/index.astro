---
import BaseLayout from '../layouts/BaseLayout.astro';
import { env } from 'cloudflare:workers';
import { getSiteUrl } from '../lib/site';
import { DEFAULT_LOCALE, localizedPath, type Locale } from '../i18n/locales';
import { t, type MessageKey } from '../i18n';

interface Props {
	locale?: Locale;
}

export const prerender = false;

const locale: Locale = Astro.props.locale || (Astro.currentLocale as Locale) || DEFAULT_LOCALE;
const siteName = env.SITE_NAME || 'Tomas Boschetto';
const linkedIn = env.LINKEDIN_URL || 'https://www.linkedin.com/in/tomasboschetto/';
const siteUrl = getSiteUrl(env);

const slideIds = ['ar', 'pe', 'ke', 'kh', 'ch'] as const;
const slides = slideIds.map((id) => {
	const countryKey = `home.slide.${id}.country` as MessageKey;
	const captionKey = `home.slide.${id}.caption` as MessageKey;
	const meta: Record<
		(typeof slideIds)[number],
		{ src: string; flag: string; photographer: string; unsplash: string; flagShape?: 'square' }
	> = {
		ar: {
			src: '/images/hero-ar.jpg',
			flag: '/images/flags/ar.png',
			photographer: 'Hans-Jürgen Weinhardt',
			unsplash: 'https://unsplash.com/photos/5RFMPufTKPA',
		},
		pe: {
			src: '/images/hero-pe.jpg',
			flag: '/images/flags/pe.png',
			photographer: 'Eddie Kiszka',
			unsplash: 'https://unsplash.com/photos/rFESpq5MMTg',
		},
		ke: {
			src: '/images/hero-ke.jpg',
			flag: '/images/flags/ke.png',
			photographer: 'Stephan Bechert',
			unsplash: 'https://unsplash.com/photos/xQWelDCacZE',
		},
		kh: {
			src: '/images/hero-kh.jpg',
			flag: '/images/flags/kh.png',
			photographer: 'James Wheeler',
			unsplash: 'https://unsplash.com/photos/9zXMb-E8pI0',
		},
		ch: {
			src: '/images/hero-ch.jpg',
			flag: '/images/flags/ch.png',
			flagShape: 'square',
			photographer: 'Karin Hugentobler',
			unsplash: 'https://unsplash.com/photos/tt3K-JvHrPY',
		},
	};
	return {
		id,
		country: t(locale, countryKey),
		caption: t(locale, captionKey),
		...meta[id],
	};
});

const jsonLd = [
	{
		'@context': 'https://schema.org',
		'@type': 'WebSite',
		name: siteName,
		url: siteUrl,
		description: t(locale, 'home.description'),
		inLanguage: locale,
	},
	{
		'@context': 'https://schema.org',
		'@type': 'Person',
		name: siteName,
		url: siteUrl,
		sameAs: [linkedIn],
	},
];
---

<BaseLayout
	locale={locale}
	title={siteName}
	description={t(locale, 'home.description')}
	image="/images/hero-ar.jpg"
	jsonLd={jsonLd}
>
	<section class="hero" aria-label={t(locale, 'nav.home')}>
		<div class="hero__media" aria-hidden="true">
			{
				slides.map((slide, i) => (
					<div
						class:list={['hero__slide', i === 0 && 'is-active']}
						data-slide={slide.id}
						style={`background-image: url('${slide.src}')`}
					/>
				))
			}
			<div class="hero__shade"></div>
		</div>

		<div class="hero__content">
			<h1 class="hero__brand">{siteName}</h1>
			<p class="hero__lead">{t(locale, 'home.lead')}</p>
			<nav class="hero__paths" aria-label={t(locale, 'home.paths')}>
				<a class="hero__path" href={localizedPath(locale, '/recommendations') + '?type=travel'}>
					<span class="hero__path-label">{t(locale, 'home.cta.trips')}</span>
					<span class="hero__path-hint">{t(locale, 'home.cta.tripsHint')}</span>
				</a>
				<a class="hero__path" href={localizedPath(locale, '/recommendations') + '?type=book'}>
					<span class="hero__path-label">{t(locale, 'home.cta.books')}</span>
					<span class="hero__path-hint">{t(locale, 'home.cta.booksHint')}</span>
				</a>
				<a class="hero__path" href={localizedPath(locale, '/recommendations') + '?type=movie'}>
					<span class="hero__path-label">{t(locale, 'home.cta.films')}</span>
					<span class="hero__path-hint">{t(locale, 'home.cta.filmsHint')}</span>
				</a>
			</nav>
		</div>

		<ul class="hero__credits" aria-label={t(locale, 'home.credits')}>
			{
				slides.map((slide, i) => (
					<li class:list={['hero__credit', i === 0 && 'is-active']} data-credit={slide.id}>
						<button
							type="button"
							class:list={['hero__flag', slide.flagShape === 'square' && 'hero__flag--square']}
							aria-describedby={`credit-${slide.id}`}
							aria-label={t(locale, 'home.photoCredit', { country: slide.country })}
						>
							<img
								src={slide.flag}
								alt=""
								width={slide.flagShape === 'square' ? 26 : 40}
								height="26"
							/>
						</button>
						<div class="hero__tip" id={`credit-${slide.id}`} role="tooltip">
							<p class="hero__tip-place">{slide.country}</p>
							<p class="hero__tip-caption">{slide.caption}</p>
							<p class="hero__tip-photo">
								{t(locale, 'home.photo.by')} {slide.photographer}
							</p>
							<p class="hero__tip-source">
								{t(locale, 'home.photo.downloaded')}{' '}
								<a href={slide.unsplash} rel="noopener noreferrer" target="_blank">
									Unsplash
								</a>
							</p>
						</div>
					</li>
				))
			}
		</ul>
	</section>

	<script>
		const slides = Array.from(document.querySelectorAll('.hero__slide'));
		const credits = Array.from(document.querySelectorAll('.hero__credit'));
		if (slides.length > 1) {
			const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
			let index = 0;
			const show = (next: number) => {
				slides[index]?.classList.remove('is-active');
				credits[index]?.classList.remove('is-active');
				index = next;
				slides[index]?.classList.add('is-active');
				credits[index]?.classList.add('is-active');
			};
			credits.forEach((credit, i) => {
				credit.querySelector('.hero__flag')?.addEventListener('click', () => show(i));
			});
			if (!reduceMotion) {
				window.setInterval(() => show((index + 1) % slides.length), 7000);
			}
		}
	</script>
</BaseLayout>
