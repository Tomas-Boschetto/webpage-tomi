---
import BaseLayout from '../layouts/BaseLayout.astro';
import { DEFAULT_LOCALE, localizedPath, type Locale } from '../i18n/locales';
import { t } from '../i18n';

interface Props {
	locale?: Locale;
}

export const prerender = false;

const locale: Locale = Astro.props.locale || (Astro.currentLocale as Locale) || DEFAULT_LOCALE;
const contactHref = localizedPath(locale, '/contact');
const newTab = t(locale, 'footer.newTab');
---

<BaseLayout
	locale={locale}
	title={t(locale, 'disclaimer.title')}
	description={t(locale, 'disclaimer.description')}
>
	<header class="section-head">
		<h1>{t(locale, 'disclaimer.title')}</h1>
		<p>{t(locale, 'disclaimer.lead')}</p>
	</header>

	<article class="about-prose disclaimer-prose">
		<section>
			<h2>{t(locale, 'disclaimer.nonCommercial.h')}</h2>
			<p>{t(locale, 'disclaimer.nonCommercial.p')}</p>
		</section>

		<section>
			<h2>{t(locale, 'disclaimer.opinions.h')}</h2>
			<p>{t(locale, 'disclaimer.opinions.p')}</p>
		</section>

		<section>
			<h2>{t(locale, 'disclaimer.apis.h')}</h2>
			<p>{t(locale, 'disclaimer.apis.p')}</p>

			<h3>{t(locale, 'disclaimer.tmdb.h')}</h3>
			<p>
				{t(locale, 'disclaimer.tmdb.pre')}{' '}
				<a href="https://www.themoviedb.org/" rel="noopener noreferrer" target="_blank"
					>{t(locale, 'disclaimer.tmdb.link')}<span class="sr-only">{' '}{newTab}</span></a
				>{t(locale, 'disclaimer.tmdb.post')}
			</p>

			<h3>{t(locale, 'disclaimer.openLibrary.h')}</h3>
			<p>
				{t(locale, 'disclaimer.openLibrary.pre')}{' '}
				<a href="https://openlibrary.org/" rel="noopener noreferrer" target="_blank"
					>{t(locale, 'disclaimer.openLibrary.link')}<span class="sr-only">{' '}{newTab}</span></a
				>{t(locale, 'disclaimer.openLibrary.post')}
			</p>

			<h3>{t(locale, 'disclaimer.wikidata.h')}</h3>
			<p>
				{t(locale, 'disclaimer.wikidata.pre')}{' '}
				<a href="https://www.wikidata.org/" rel="noopener noreferrer" target="_blank"
					>{t(locale, 'disclaimer.wikidata.link')}<span class="sr-only">{' '}{newTab}</span></a
				>{t(locale, 'disclaimer.wikidata.mid')}{' '}
				<a
					href="https://creativecommons.org/publicdomain/zero/1.0/"
					rel="noopener noreferrer"
					target="_blank"
					>{t(locale, 'disclaimer.wikidata.cc0')}<span class="sr-only">{' '}{newTab}</span></a
				>{t(locale, 'disclaimer.wikidata.post')}
			</p>

			<h3>{t(locale, 'disclaimer.wikipedia.h')}</h3>
			<p>
				{t(locale, 'disclaimer.wikipedia.pre')}{' '}
				<a href="https://www.wikipedia.org/" rel="noopener noreferrer" target="_blank"
					>{t(locale, 'disclaimer.wikipedia.link')}<span class="sr-only">{' '}{newTab}</span></a
				>{t(locale, 'disclaimer.wikipedia.post')}
			</p>

			<h3>{t(locale, 'disclaimer.unsplash.h')}</h3>
			<p>
				{t(locale, 'disclaimer.unsplash.pre')}{' '}
				<a href="https://unsplash.com/" rel="noopener noreferrer" target="_blank"
					>{t(locale, 'disclaimer.unsplash.link')}<span class="sr-only">{' '}{newTab}</span></a
				>{t(locale, 'disclaimer.unsplash.mid1')}{' '}
				<a href="https://unsplash.com/license" rel="noopener noreferrer" target="_blank"
					>{t(locale, 'disclaimer.unsplash.license')}<span class="sr-only">{' '}{newTab}</span></a
				>{' '}
				{t(locale, 'disclaimer.unsplash.and')}{' '}
				<a href="https://unsplash.com/api/terms" rel="noopener noreferrer" target="_blank"
					>{t(locale, 'disclaimer.unsplash.guidelines')}<span class="sr-only"
						>{' '}{newTab}</span
					></a
				>{t(locale, 'disclaimer.unsplash.post')}
			</p>

			<h3>{t(locale, 'disclaimer.maps.h')}</h3>
			<p>
				{t(locale, 'disclaimer.maps.pre')}{' '}
				<a href="https://www.openstreetmap.org/copyright" rel="noopener noreferrer" target="_blank"
					>{t(locale, 'disclaimer.maps.osm')}<span class="sr-only">{' '}{newTab}</span></a
				>{' '}
				{t(locale, 'disclaimer.maps.mid1')}{' '}
				<a href="https://leafletjs.com/" rel="noopener noreferrer" target="_blank"
					>{t(locale, 'disclaimer.maps.leaflet')}<span class="sr-only">{' '}{newTab}</span></a
				>{' '}
				{t(locale, 'disclaimer.maps.mid2')}{' '}
				<a href="https://developers.google.com/maps" rel="noopener noreferrer" target="_blank"
					>{t(locale, 'disclaimer.maps.google')}<span class="sr-only">{' '}{newTab}</span></a
				>{' '}
				{t(locale, 'disclaimer.maps.mid3')}{' '}
				<a href="https://nominatim.org/" rel="noopener noreferrer" target="_blank"
					>{t(locale, 'disclaimer.maps.nominatim')}<span class="sr-only">{' '}{newTab}</span></a
				>{t(locale, 'disclaimer.maps.post')}
			</p>

			<h3>{t(locale, 'disclaimer.ratings.h')}</h3>
			<p>{t(locale, 'disclaimer.ratings.p')}</p>

			<h3>{t(locale, 'disclaimer.googleBooks.h')}</h3>
			<p>
				{t(locale, 'disclaimer.googleBooks.pre')}<a
					href="https://developers.google.com/books"
					rel="noopener noreferrer"
					target="_blank"
					>{t(locale, 'disclaimer.googleBooks.link')}<span class="sr-only">{' '}{newTab}</span></a
				>{t(locale, 'disclaimer.googleBooks.post')}
			</p>

			<h3>{t(locale, 'disclaimer.omdb.h')}</h3>
			<p>
				{t(locale, 'disclaimer.omdb.pre')}{' '}
				<a href="https://www.omdbapi.com/" rel="noopener noreferrer" target="_blank"
					>{t(locale, 'disclaimer.omdb.link')}<span class="sr-only">{' '}{newTab}</span></a
				>{t(locale, 'disclaimer.omdb.post')}
			</p>
		</section>

		<section>
			<h2>{t(locale, 'disclaimer.trademarks.h')}</h2>
			<p>{t(locale, 'disclaimer.trademarks.p')}</p>
		</section>

		<section>
			<h2>{t(locale, 'disclaimer.translations.h')}</h2>
			<p>
				{t(locale, 'disclaimer.translations.pre')}{' '}
				<a href={contactHref}>{t(locale, 'disclaimer.translations.link')}</a>{t(
					locale,
					'disclaimer.translations.post',
				)}
			</p>
		</section>

		<section>
			<h2>{t(locale, 'disclaimer.accuracy.h')}</h2>
			<p>
				{t(locale, 'disclaimer.accuracy.pre')}{' '}
				<a href={contactHref}>{t(locale, 'disclaimer.accuracy.link')}</a>{t(
					locale,
					'disclaimer.accuracy.post',
				)}
			</p>
		</section>

		<section>
			<h2>{t(locale, 'disclaimer.contact.h')}</h2>
			<p>
				{t(locale, 'disclaimer.contact.pre')}{' '}
				<a href={contactHref}>{t(locale, 'disclaimer.contact.link')}</a>{t(
					locale,
					'disclaimer.contact.post',
				)}
			</p>
		</section>
	</article>
</BaseLayout>
