---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { env } from 'cloudflare:workers';
import { isAdminAuthorized } from '../../lib/auth';

export const prerender = false;

const authorized = isAdminAuthorized(Astro.request, env);
const viewParam = Astro.url.searchParams.get('view');
const view = viewParam === 'books' ? 'books' : 'movies';
---

<BaseLayout title="Admin" description="Manage movie and book recommendations." robots="noindex, nofollow">
	<header class="section-head">
		<h1>Admin</h1>
		<p>
			{view === 'books'
				? 'Manage books here. Switch tabs for movies or travel trips.'
				: 'Manage movies here. Switch tabs for books or travel trips.'}
		</p>
	</header>

	{
		!authorized ? (
			<p class="form__status form__status--err">
				Unauthorized. In production, open this page after Cloudflare Access login. Locally, set
				<code>ADMIN_DEV_BYPASS=true</code> in <code>.dev.vars</code>.
			</p>
		) : (
			<>
				<nav class="tabs" aria-label="Admin sections">
					<a href="/admin?view=movies" aria-current={view === 'movies' ? 'page' : undefined}
						>Movies</a
					>
					<a href="/admin?view=books" aria-current={view === 'books' ? 'page' : undefined}>Books</a>
					<a href="/admin/trips">Trips</a>
				</nav>

				<div
					class="admin-layout admin-layout--stack"
					id="admin-app"
					data-view={view}
				>
					{
						view === 'movies' ? (
							<section class="admin-panel">
								<h2>Movies</h2>
								<div class="admin-list" id="movies-list">
									<p class="empty">Loading…</p>
								</div>
							</section>
						) : (
							<section class="admin-panel">
								<h2>Books</h2>
								<div class="admin-list" id="books-list">
									<p class="empty">Loading…</p>
								</div>
							</section>
						)
					}

					<section class="admin-add">
						<button class="btn btn--primary" type="button" id="add-toggle">
							{view === 'books' ? 'Add book' : 'Add movie'}
						</button>
						<div class="admin-expand" id="add-panel" hidden>
							<div id="add-form-host"></div>
						</div>
						<p class="form__status" id="admin-status" role="status" aria-live="polite"></p>
					</section>
				</div>
			</>
		)
	}
</BaseLayout>

{
	authorized && (
		<script>
			import { formatAccoladesForAdmin, normalizeAccoladesInput } from '../../lib/accolades';
			import {
				formatExternalRatingsForAdmin,
				normalizeExternalRatingsInput,
			} from '../../lib/external-ratings';
			import { STANDARD_GENRES } from '../../lib/genres';

			const app = document.getElementById('admin-app');
			const view = app?.dataset.view === 'books' ? 'books' : 'movies';
			const type = view === 'books' ? 'book' : 'movie';
			const listEl = document.getElementById(view === 'books' ? 'books-list' : 'movies-list');
			const statusEl = document.getElementById('admin-status');
			const addToggle = document.getElementById('add-toggle');
			const addPanel = document.getElementById('add-panel');
			const addFormHost = document.getElementById('add-form-host');

			/** @type {any[]} */
			let itemsCache = [];

			function setStatus(message, ok = true) {
				statusEl.className = `form__status ${ok ? 'form__status--ok' : 'form__status--err'}`;
				statusEl.textContent = message;
			}

			function escapeHtml(value) {
				return String(value)
					.replaceAll('&', '&amp;')
					.replaceAll('<', '&lt;')
					.replaceAll('>', '&gt;')
					.replaceAll('"', '&quot;');
			}

			function closeAllEditors() {
				document.querySelectorAll('.admin-row__editor').forEach((el) => {
					el.hidden = true;
					el.innerHTML = '';
				});
				document.querySelectorAll('.admin-row-block.is-editing').forEach((el) => {
					el.classList.remove('is-editing');
				});
			}

			function closeAddPanel() {
				addPanel.hidden = true;
				addFormHost.innerHTML = '';
				addToggle.setAttribute('aria-expanded', 'false');
			}

			/**
			 * @param {'movie' | 'book'} formType
			 * @param {any | null} item
			 * @param {'create' | 'edit'} mode
			 */
			function buildFormHtml(formType, item, mode) {
				const isBook = formType === 'book';
				const id = item?.id || '';
				const title = escapeHtml(item?.title || '');
				const summary = escapeHtml(item?.summary || '');
				const commentary = escapeHtml(item?.commentary || '');
				const experiencedRaw = String(item?.experienced_at || '');
				const experienced = escapeHtml(
					isBook ? experiencedRaw.slice(0, 7) : experiencedRaw.slice(0, 10),
				);
				const edition = escapeHtml((item?.edition_published_at || '').slice(0, 10));
				const originalPublished = escapeHtml(
					(item?.original_published_at || '').slice(0, 10),
				);
				const accolades = escapeHtml(formatAccoladesForAdmin(item?.accolades || ''));
				const accoladesSource = escapeHtml(
					item?.accolades && String(item.accolades).includes('"wikidata"') ? 'wikidata' : 'manual',
				);
				const externalRatings = escapeHtml(
					formatExternalRatingsForAdmin(item?.external_ratings || ''),
				);
				const rating = item?.rating != null ? String(item.rating) : '';
				const genre = escapeHtml(item?.genre || '');
				const director = escapeHtml(item?.director || '');
				const cast = escapeHtml(item?.cast_members || '');
				const imdb = escapeHtml(item?.imdb_url || '');
				const goodreads = escapeHtml(item?.goodreads_url || '');
				const url = escapeHtml(item?.url || '');
				const image = escapeHtml(item?.image_url || '');
				const published = !item || item.published === 1;

				const titleFieldId = `admin-title-${mode}-${Math.random().toString(36).slice(2, 8)}`;
				const suggestId = `${titleFieldId}-suggestions`;

				return `
					<form class="form admin-entry-form" data-mode="${mode}" data-type="${formType}">
						<input type="hidden" name="id" value="${id}" />
						<input type="hidden" name="type" value="${formType}" />
						<div class="admin-title-combo">
							<label for="${titleFieldId}">Title</label>
							<input
								id="${titleFieldId}"
								type="text"
								name="title"
								required
								maxlength="200"
								value="${title}"
								data-field="title"
								data-lookup-title
								role="combobox"
								aria-autocomplete="list"
								aria-expanded="false"
								aria-controls="${suggestId}"
								autocomplete="off"
								placeholder="${isBook ? 'Start typing a book title…' : 'Start typing a movie title…'}"
							/>
							<ul
								id="${suggestId}"
								class="admin-title-combo__list"
								data-lookup-list
								role="listbox"
								hidden
							></ul>
						</div>
						<p class="form__status" data-lookup-status role="status" aria-live="polite"></p>
						<p class="admin-cover__hint">
							${
								isBook
									? 'Suggestions appear under the title as you type (Open Library). Author below can narrow results.'
									: 'Suggestions appear under the title as you type (TMDB). Pick one to fill the rest.'
							}
						</p>
						<label>
							Synopsis
							<textarea name="summary" required maxlength="2000" data-field="summary" placeholder="Filled from TMDB / Open Library">${summary}</textarea>
						</label>
						<p class="admin-cover__hint">Synopsis is the third-party plot summary (TMDB for movies, Open Library for books).</p>
						<label>
							My commentary
							<textarea name="commentary" maxlength="4000" rows="4" data-field="commentary" placeholder="Your personal take — required for a good recommendation">${commentary}</textarea>
						</label>
						<p class="admin-cover__hint">Commentary is your voice. It shows on the list and detail pages; awards only appear on the detail page.</p>
						<label>
							${isBook ? 'Month read' : 'Date watched'}
							<input type="${isBook ? 'month' : 'date'}" name="experienced_at" required value="${experienced}" />
						</label>
						<label>
							${isBook ? 'Edition published (optional)' : 'Release date (optional)'}
							<input type="date" name="edition_published_at" value="${edition}" data-field="edition_published_at" />
						</label>
						${
							isBook
								? `
						<label>
							Originally published (optional)
							<input type="date" name="original_published_at" value="${originalPublished}" data-field="original_published_at" />
						</label>`
								: `
						<input type="hidden" name="original_published_at" value="${originalPublished || edition}" data-field="original_published_at" />`
						}
						<label>
							Accolades (optional)
							<textarea name="accolades" maxlength="2500" rows="6" data-field="accolades" placeholder="Grouped by institution after lookup&#10;Pulitzer Prize&#10;• Fiction">${accolades}</textarea>
							<input type="hidden" name="accolades_source" value="${accoladesSource}" data-field="accolades_source" />
						</label>
						<label>
							Rating (0–5) — yours
							<input type="number" name="rating" min="0" max="5" step="0.5" placeholder="4.5" value="${rating}" />
						</label>
						<label>
							Marketplace ratings (optional)
							<textarea name="external_ratings" maxlength="2500" rows="4" data-field="external_ratings" placeholder="Filled from lookup&#10;TMDB: 7.8 / 10 (12345 votes)">${externalRatings}</textarea>
						</label>
						<p class="admin-cover__hint">Your rating is what shows as stars. Marketplace scores (TMDB, IMDb, Open Library, Google Books) appear on the detail page with credit.</p>
						<label>
							Genre
							<input
								type="text"
								name="genre"
								maxlength="200"
								value="${genre}"
								data-field="genre"
								list="standard-genres"
								placeholder="Drama, Mystery & Thriller"
							/>
							<datalist id="standard-genres">
								${STANDARD_GENRES.map((g) => `<option value="${g}"></option>`).join('')}
							</datalist>
						</label>
						<p class="admin-cover__hint">
							Pick from the 20 standard genres (suggestions appear as you type). Up to a few per title is enough.
						</p>
						<label>
							${isBook ? 'Author' : 'Director'}
							<input type="text" name="director" maxlength="500" value="${director}" data-field="director" data-lookup-creator />
						</label>
						${
							isBook
								? `
						<label>
							Goodreads link
							<input type="url" name="goodreads_url" maxlength="500" placeholder="https://www.goodreads.com/book/show/…" value="${goodreads}" data-field="goodreads_url" />
						</label>`
								: `
						<label>
							Cast
							<input type="text" name="cast" maxlength="500" placeholder="Comma-separated names" value="${cast}" data-field="cast" />
						</label>
						<label>
							IMDb link
							<input type="url" name="imdb_url" maxlength="500" placeholder="https://www.imdb.com/title/…" value="${imdb}" data-field="imdb_url" />
						</label>`
						}
						<label>
							Wikipedia URL (optional)
							<input type="url" name="url" maxlength="500" placeholder="https://en.wikipedia.org/wiki/…" value="${url}" data-field="url" />
						</label>
						<div class="admin-cover">
							<div class="admin-cover__picker" data-cover-pick-wrap>
								<p class="admin-cover__label">${isBook ? 'Choose a cover' : 'Choose a poster'}</p>
								<p class="admin-cover__empty" data-cover-empty hidden>
									No match for this title — nothing to choose from yet. Pick a suggestion above, or paste a URL below.
								</p>
								<div
									class="admin-cover__grid"
									data-cover-pick
									role="listbox"
									aria-label="${isBook ? 'Cover options' : 'Poster options'}"
								></div>
								<button class="btn btn--ghost" type="button" data-cover-more hidden>
									Show more
								</button>
								<p class="admin-cover__credit" data-cover-credit hidden></p>
							</div>
							<label>
								Cover image URL (optional)
								<input type="url" name="image_url" maxlength="500" placeholder="https://" value="${image}" data-cover-url data-field="image_url" />
							</label>
							<img
								class="admin-cover__preview"
								data-cover-preview
								src="${image || ''}"
								alt=""
								width="120"
								height="180"
								${image ? '' : 'hidden'}
							/>
							<p class="admin-cover__hint">Pick a thumbnail above, or paste a URL.</p>
						</div>
						<label class="checkbox-row">
							<input type="checkbox" name="published" ${published ? 'checked' : ''} />
							Published
						</label>
						<div class="form__actions">
							<button class="btn btn--primary" type="submit">${mode === 'edit' ? 'Save changes' : 'Create'}</button>
							<button class="btn btn--ghost" type="button" data-action="cancel">Cancel</button>
						</div>
					</form>
				`;
			}

			/**
			 * @param {HTMLFormElement} form
			 */
			function payloadFromForm(form) {
				const data = new FormData(form);
				const formType = String(data.get('type') || '');
				const isBook = formType === 'book';
				const ratingRaw = String(data.get('rating') || '').trim();
				return {
					type: formType,
					title: String(data.get('title') || ''),
					summary: String(data.get('summary') || ''),
					commentary: String(data.get('commentary') || '') || null,
					experienced_at: String(data.get('experienced_at') || ''),
					edition_published_at: String(data.get('edition_published_at') || '') || null,
					original_published_at: isBook
						? String(data.get('original_published_at') || '') || null
						: String(data.get('edition_published_at') || '') ||
							String(data.get('original_published_at') || '') ||
							null,
					accolades: normalizeAccoladesInput(
						String(data.get('accolades') || ''),
						String(data.get('accolades_source') || '') === 'wikidata' ? 'wikidata' : 'manual',
					),
					external_ratings: normalizeExternalRatingsInput(
						String(data.get('external_ratings') || ''),
					),
					rating: ratingRaw === '' ? null : Number(ratingRaw),
					genre: String(data.get('genre') || '') || null,
					director: String(data.get('director') || '') || null,
					cast_members: isBook ? null : String(data.get('cast') || '') || null,
					imdb_url: isBook ? null : String(data.get('imdb_url') || '') || null,
					goodreads_url: isBook ? String(data.get('goodreads_url') || '') || null : null,
					url: String(data.get('url') || '') || null,
					image_url: String(data.get('image_url') || '') || null,
					published: form.querySelector('[name="published"]')?.checked === true,
				};
			}

			/**
			 * @param {HTMLElement} host
			 * @param {'movie' | 'book'} formType
			 * @param {any | null} item
			 * @param {'create' | 'edit'} mode
			 * @param {() => void} onCancel
			 */
			function mountForm(host, formType, item, mode, onCancel) {
				host.innerHTML = buildFormHtml(formType, item, mode);
				const form = host.querySelector('form');
				const coverInput = form?.querySelector('[data-cover-url]');
				const coverPreview = form?.querySelector('[data-cover-preview]');
				const lookupStatus = form?.querySelector('[data-lookup-status]');
				const coverPickWrap = form?.querySelector('[data-cover-pick-wrap]');
				const coverPick = form?.querySelector('[data-cover-pick]');
				const coverMoreBtn = form?.querySelector('[data-cover-more]');
				const coverEmpty = form?.querySelector('[data-cover-empty]');
				const coverCredit = form?.querySelector('[data-cover-credit]');
				const titleInput = form?.querySelector('[data-lookup-title]');
				const creatorInput = form?.querySelector('[data-lookup-creator]');
				const suggestList = form?.querySelector('[data-lookup-list]');

				/** @type {ReturnType<typeof setTimeout> | null} */
				let searchTimer = null;
				/** @type {AbortController | null} */
				let searchAbort = null;
				/** @type {Array<{ id: string, title: string, subtitle: string, image_url?: string | null }>} */
				let currentMatches = [];
				let activeIndex = -1;
				/** @type {string[]} */
				let allCoverImages = [];
				let coverVisibleCount = 0;
				const COVER_PAGE = 10;

				function setLookupStatus(message, ok = true) {
					if (!lookupStatus) return;
					if (!message) {
						lookupStatus.textContent = '';
						lookupStatus.className = 'form__status';
						return;
					}
					lookupStatus.className = `form__status ${ok ? 'form__status--ok' : 'form__status--err'}`;
					lookupStatus.textContent = message;
				}

				function hideSuggestions() {
					if (!(suggestList instanceof HTMLElement)) return;
					suggestList.hidden = true;
					suggestList.innerHTML = '';
					currentMatches = [];
					activeIndex = -1;
					if (titleInput instanceof HTMLInputElement) {
						titleInput.setAttribute('aria-expanded', 'false');
						titleInput.removeAttribute('aria-activedescendant');
					}
				}

				function setActiveOption(index) {
					if (!(suggestList instanceof HTMLElement)) return;
					const options = [...suggestList.querySelectorAll('[role="option"]')];
					activeIndex = index;
					options.forEach((opt, i) => {
						const on = i === index;
						opt.setAttribute('aria-selected', on ? 'true' : 'false');
						opt.classList.toggle('is-active', on);
					});
					if (titleInput instanceof HTMLInputElement) {
						if (index >= 0 && options[index]) {
							titleInput.setAttribute('aria-activedescendant', options[index].id);
						} else {
							titleInput.removeAttribute('aria-activedescendant');
						}
					}
					options[index]?.scrollIntoView({ block: 'nearest' });
				}

				function renderSuggestions(matches) {
					if (!(suggestList instanceof HTMLElement) || !(titleInput instanceof HTMLInputElement)) {
						return;
					}
					currentMatches = matches;
					activeIndex = -1;
					suggestList.innerHTML = '';
					if (!matches.length) {
						hideSuggestions();
						return;
					}
					matches.forEach((match, index) => {
						const li = document.createElement('li');
						li.id = `${suggestList.id}-opt-${index}`;
						li.setAttribute('role', 'option');
						li.setAttribute('aria-selected', 'false');
						li.dataset.id = match.id;
						li.dataset.index = String(index);
						const thumb = match.image_url
							? `<img class="admin-title-combo__thumb" src="${escapeHtml(match.image_url)}" alt="" width="28" height="42" loading="lazy" decoding="async" />`
							: `<span class="admin-title-combo__thumb admin-title-combo__thumb--empty" aria-hidden="true"></span>`;
						li.innerHTML = `
							${thumb}
							<span class="admin-title-combo__text">
								<span class="admin-title-combo__name">${escapeHtml(match.title)}</span>
								${match.subtitle ? `<span class="admin-title-combo__sub">${escapeHtml(match.subtitle)}</span>` : ''}
							</span>
						`;
						li.addEventListener('mousedown', (event) => {
							event.preventDefault();
							void selectMatch(match.id);
						});
						suggestList.appendChild(li);
					});
					suggestList.hidden = false;
					titleInput.setAttribute('aria-expanded', 'true');
				}

				function syncCoverPreview(url) {
					if (!(coverPreview instanceof HTMLImageElement)) return;
					const next = String(url || '').trim();
					if (!next) {
						coverPreview.hidden = true;
						coverPreview.removeAttribute('src');
						return;
					}
					coverPreview.hidden = false;
					coverPreview.src = next;
				}

				function setField(name, value) {
					const el = form?.querySelector(`[data-field="${name}"]`);
					if (el instanceof HTMLInputElement || el instanceof HTMLTextAreaElement) {
						el.value = value == null ? '' : String(value);
					}
				}

				function setCoverEmpty(message) {
					if (!(coverEmpty instanceof HTMLElement)) return;
					if (!message) {
						coverEmpty.hidden = true;
						coverEmpty.textContent = '';
						return;
					}
					coverEmpty.hidden = false;
					coverEmpty.textContent = message;
				}

				function setCoverCredit(source) {
					if (!(coverCredit instanceof HTMLElement)) return;
					if (source === 'tmdb') {
						coverCredit.hidden = false;
						coverCredit.innerHTML =
							'Posters from <a href="https://www.themoviedb.org/" rel="noopener noreferrer" target="_blank">TMDB</a>. This product uses the TMDB API but is not endorsed or certified by TMDB.';
					} else if (source === 'openlibrary') {
						coverCredit.hidden = false;
						coverCredit.innerHTML =
							'Covers from <a href="https://openlibrary.org/" rel="noopener noreferrer" target="_blank">Open Library</a>.';
					} else {
						coverCredit.hidden = true;
						coverCredit.textContent = '';
					}
				}

				function markCoverSelected(url) {
					if (!(coverPick instanceof HTMLElement)) return;
					coverPick.querySelectorAll('[data-cover-choice]').forEach((btn) => {
						const on = btn instanceof HTMLElement && btn.dataset.url === url;
						btn.classList.toggle('is-selected', on);
						btn.setAttribute('aria-selected', on ? 'true' : 'false');
					});
				}

				function chooseCover(url) {
					if (coverInput instanceof HTMLInputElement) coverInput.value = url;
					syncCoverPreview(url);
					markCoverSelected(url);
				}

				function appendCoverSlice() {
					if (!(coverPick instanceof HTMLElement)) return;
					const next = allCoverImages.slice(coverVisibleCount, coverVisibleCount + COVER_PAGE);
					next.forEach((url, offset) => {
						const index = coverVisibleCount + offset;
						const btn = document.createElement('button');
						btn.type = 'button';
						btn.className = 'admin-cover__choice';
						btn.dataset.coverChoice = '';
						btn.dataset.url = url;
						btn.setAttribute('role', 'option');
						btn.setAttribute('aria-selected', 'false');
						btn.setAttribute('aria-label', `Cover option ${index + 1}`);
						const img = document.createElement('img');
						img.src = url;
						img.alt = '';
						img.width = 72;
						img.height = 108;
						img.loading = 'lazy';
						img.decoding = 'async';
						btn.appendChild(img);
						btn.addEventListener('click', () => chooseCover(url));
						coverPick.appendChild(btn);
					});
					coverVisibleCount += next.length;
					if (coverMoreBtn instanceof HTMLButtonElement) {
						const remaining = allCoverImages.length - coverVisibleCount;
						coverMoreBtn.hidden = remaining <= 0;
						coverMoreBtn.textContent =
							remaining > 0
								? `Show more (${Math.min(COVER_PAGE, remaining)} of ${remaining} left)`
								: 'Show more';
					}
				}

				function fillImageOptions(images, preferred, source) {
					if (!(coverPick instanceof HTMLElement)) return;
					allCoverImages = [...new Set((Array.isArray(images) ? images : []).filter(Boolean))];
					coverVisibleCount = 0;
					coverPick.innerHTML = '';

					if (!allCoverImages.length) {
						setCoverEmpty(
							formType === 'book'
								? 'No covers available for this title. Paste a URL below if you have one.'
								: 'No posters available for this title. Paste a URL below if you have one.',
						);
						if (coverMoreBtn instanceof HTMLButtonElement) coverMoreBtn.hidden = true;
						setCoverCredit(source || null);
						return;
					}

					setCoverEmpty('');
					appendCoverSlice();
					const next =
						preferred && allCoverImages.includes(preferred)
							? preferred
							: allCoverImages[0] || '';
					if (next) chooseCover(next);
					setCoverCredit(source || null);
				}

				async function selectMatch(id) {
					if (!(form instanceof HTMLFormElement) || !id) return;
					hideSuggestions();
					setLookupStatus('Loading details…');
					const res = await fetch('/api/admin/lookup', {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify({ action: 'select', type: formType, id }),
					});
					const json = await res.json();
					if (!res.ok) {
						setLookupStatus(json.error || 'Could not load details.', false);
						return;
					}
					setField('title', json.title);
					setField('summary', json.summary);
					setField('genre', json.genre);
					setField('director', json.director);
					setField('cast', json.cast_members);
					setField('imdb_url', json.imdb_url);
					setField('goodreads_url', json.goodreads_url);
					setField('url', json.url);
					if (json.edition_published_at) {
						const editionEl = form.querySelector('[data-field="edition_published_at"]');
						if (editionEl instanceof HTMLInputElement) {
							editionEl.value = String(json.edition_published_at).slice(0, 10);
						}
					}
					const originalValue = json.original_published_at || '';
					if (originalValue) {
						const originalEl = form.querySelector('[data-field="original_published_at"]');
						if (originalEl instanceof HTMLInputElement) {
							originalEl.value = String(originalValue).slice(0, 10);
						}
					} else {
						const originalEl = form.querySelector('[data-field="original_published_at"]');
						if (originalEl instanceof HTMLInputElement && formType === 'book') {
							originalEl.value = '';
						}
					}
					if (formType === 'movie' && json.edition_published_at) {
						const originalEl = form.querySelector('[data-field="original_published_at"]');
						if (originalEl instanceof HTMLInputElement) {
							originalEl.value = String(json.edition_published_at).slice(0, 10);
						}
					}
					setField('accolades', formatAccoladesForAdmin(json.accolades || ''));
					const sourceEl = form.querySelector('[data-field="accolades_source"]');
					if (sourceEl instanceof HTMLInputElement) {
						sourceEl.value = json.accolades ? 'wikidata' : 'manual';
					}
					setField(
						'external_ratings',
						formatExternalRatingsForAdmin(json.external_ratings || ''),
					);
					fillImageOptions(json.images || [], json.image_url, json.source);
					const extras = [];
					if (json.accolades) extras.push('awards via Wikidata (CC0)');
					else extras.push('no awards found on Wikidata');
					if (json.external_ratings) extras.push('marketplace ratings');
					if (json.goodreads_url) extras.push('Goodreads link');
					if (json.url) extras.push('Wikipedia');
					const extraText = extras.length ? ` ${extras.join(', ')}.` : '';
					setLookupStatus(
						`Filled from “${json.matched_title}”.${extraText} ${json.attribution || ''}`.trim(),
					);
				}

				async function runTitleSearch() {
					if (!(form instanceof HTMLFormElement)) return;
					const query = titleInput instanceof HTMLInputElement ? titleInput.value.trim() : '';
					const creator =
						creatorInput instanceof HTMLInputElement ? creatorInput.value.trim() : '';

					searchAbort?.abort();
					searchAbort = null;

					if (query.length < 3) {
						hideSuggestions();
						setLookupStatus(query.length ? 'Keep typing (3+ letters)…' : '');
						setCoverEmpty('');
						return;
					}

					const controller = new AbortController();
					searchAbort = controller;
					setLookupStatus('Searching…');

					try {
						const res = await fetch('/api/admin/lookup', {
							method: 'POST',
							headers: { 'Content-Type': 'application/json' },
							signal: controller.signal,
							body: JSON.stringify({
								action: 'search',
								type: formType,
								query,
								creator,
							}),
						});
						const json = await res.json();
						if (controller.signal.aborted) return;
						if (!res.ok) {
							hideSuggestions();
							setLookupStatus(json.error || 'Lookup failed.', false);
							setCoverEmpty(
								formType === 'book'
									? 'No match for this title — no covers to choose from. Try another title, or paste a URL below.'
									: 'No match for this title — no posters to choose from. Try another title, or paste a URL below.',
							);
							allCoverImages = [];
							coverVisibleCount = 0;
							if (coverPick instanceof HTMLElement) coverPick.innerHTML = '';
							if (coverMoreBtn instanceof HTMLButtonElement) coverMoreBtn.hidden = true;
							setCoverCredit(null);
							return;
						}
						const matches = Array.isArray(json.matches) ? json.matches : [];
						renderSuggestions(matches);
						if (!matches.length) {
							setCoverEmpty(
								formType === 'book'
									? 'No match for this title — no covers to choose from. Try another title, or paste a URL below.'
									: 'No match for this title — no posters to choose from. Try another title, or paste a URL below.',
							);
							allCoverImages = [];
							coverVisibleCount = 0;
							if (coverPick instanceof HTMLElement) coverPick.innerHTML = '';
							if (coverMoreBtn instanceof HTMLButtonElement) coverMoreBtn.hidden = true;
							setCoverCredit(null);
							setLookupStatus('No matches.', false);
						} else {
							setCoverEmpty(
								'Pick a matching title above to load cover options.',
							);
							setLookupStatus('');
						}
					} catch (err) {
						if (err?.name === 'AbortError') return;
						hideSuggestions();
						setLookupStatus('Lookup failed.', false);
						setCoverEmpty(
							formType === 'book'
								? 'No match for this title — no covers to choose from. Try another title, or paste a URL below.'
								: 'No match for this title — no posters to choose from. Try another title, or paste a URL below.',
						);
					}
				}

				function scheduleTitleSearch() {
					if (searchTimer) clearTimeout(searchTimer);
					searchTimer = setTimeout(() => {
						searchTimer = null;
						void runTitleSearch();
					}, 450);
				}

				coverInput?.addEventListener('input', () => {
					const next = coverInput instanceof HTMLInputElement ? coverInput.value : '';
					syncCoverPreview(next);
					markCoverSelected(next.trim());
				});

				coverMoreBtn?.addEventListener('click', () => {
					appendCoverSlice();
				});

				titleInput?.addEventListener('input', scheduleTitleSearch);
				titleInput?.addEventListener('keydown', (event) => {
					if (!(event instanceof KeyboardEvent)) return;
					const open =
						suggestList instanceof HTMLElement &&
						!suggestList.hidden &&
						currentMatches.length > 0;
					if (event.key === 'ArrowDown' && open) {
						event.preventDefault();
						setActiveOption(Math.min(activeIndex + 1, currentMatches.length - 1));
					} else if (event.key === 'ArrowUp' && open) {
						event.preventDefault();
						setActiveOption(Math.max(activeIndex - 1, 0));
					} else if (event.key === 'Enter' && open && activeIndex >= 0) {
						event.preventDefault();
						void selectMatch(currentMatches[activeIndex].id);
					} else if (event.key === 'Escape' && open) {
						event.preventDefault();
						hideSuggestions();
					}
				});
				titleInput?.addEventListener('blur', () => {
					setTimeout(() => hideSuggestions(), 120);
				});
				if (formType === 'book') {
					creatorInput?.addEventListener('input', scheduleTitleSearch);
				}

				form?.querySelector('[data-action="cancel"]')?.addEventListener('click', onCancel);
				form?.addEventListener('submit', async (event) => {
					event.preventDefault();
					const editingId = String(new FormData(form).get('id') || '');
					const payload = payloadFromForm(form);
					const res = await fetch(
						editingId ? `/api/admin/recommendations/${editingId}` : '/api/admin/recommendations',
						{
							method: editingId ? 'PUT' : 'POST',
							headers: { 'Content-Type': 'application/json' },
							body: JSON.stringify(payload),
						},
					);
					const json = await res.json();
					if (!res.ok) {
						setStatus(json.error || 'Save failed.', false);
						return;
					}
					setStatus(editingId ? 'Updated.' : 'Created.');
					onCancel();
					await loadList();
				});

				if (mode === 'edit' && item?.image_url) {
					fillImageOptions(
						[String(item.image_url).trim()],
						String(item.image_url).trim(),
						formType === 'movie' ? 'tmdb' : 'openlibrary',
					);
				} else if (mode === 'create') {
					setCoverEmpty(
						formType === 'book'
							? 'Type a title to search covers. If nothing matches, you’ll see that here.'
							: 'Type a title to search posters. If nothing matches, you’ll see that here.',
					);
				}
			}

			/**
			 * @param {any[]} items
			 * @param {'movie' | 'book'} formType
			 * @param {HTMLElement} target
			 */
			function renderList(items, formType, target) {
				const filtered = items.filter((item) => item.type === formType);
				if (!filtered.length) {
					target.innerHTML = `<p class="empty">No ${formType === 'movie' ? 'movies' : 'books'} yet.</p>`;
					return;
				}

				target.innerHTML = filtered
					.map((item) => {
						const cover = item.image_url
							? `<img class="admin-row__thumb" src="${escapeHtml(item.image_url)}" alt="" width="48" height="72" loading="lazy" decoding="async" />`
							: `<span class="admin-row__thumb admin-row__thumb--empty" aria-hidden="true"></span>`;
						return `
					<div class="admin-row-block" data-id="${escapeHtml(item.id)}">
						<div class="admin-row admin-row--media">
							<div class="admin-row__main">
								<div class="admin-row__title">${escapeHtml(item.title)}</div>
								<div class="admin-row__meta">
									${
										item.experienced_at
											? `${escapeHtml(
													formType === 'book'
														? String(item.experienced_at).slice(0, 7)
														: String(item.experienced_at).slice(0, 10),
												)}`
											: 'No date'
									}
									${item.rating != null ? ` · ${item.rating}/5` : ''}
									${item.genre ? ` · ${escapeHtml(item.genre)}` : ''}
									· ${item.published ? 'published' : '<span class="badge badge--draft">draft</span>'}
								</div>
								<div class="admin-row__actions">
									<button class="btn btn--ghost" type="button" data-action="edit">Edit</button>
									<button class="btn btn--danger" type="button" data-action="delete">Delete</button>
								</div>
							</div>
							${cover}
						</div>
						<div class="admin-row__editor admin-expand" hidden></div>
					</div>`;
					})
					.join('');

				target.querySelectorAll('.admin-row-block').forEach((block) => {
					const id = block.dataset.id;
					const item = itemsCache.find((r) => r.id === id);
					if (!item) return;

					block.querySelector('[data-action="edit"]')?.addEventListener('click', () => {
						closeAddPanel();
						const already = block.classList.contains('is-editing');
						closeAllEditors();
						if (already) return;
						block.classList.add('is-editing');
						const editor = block.querySelector('.admin-row__editor');
						if (!editor) return;
						editor.hidden = false;
						mountForm(editor, formType, item, 'edit', () => {
							closeAllEditors();
						});
					});

					block.querySelector('[data-action="delete"]')?.addEventListener('click', async () => {
						if (!confirm(`Delete “${item.title}”?`)) return;
						const del = await fetch(`/api/admin/recommendations/${id}`, { method: 'DELETE' });
						if (!del.ok) {
							setStatus('Delete failed.', false);
							return;
						}
						setStatus('Deleted.');
						closeAllEditors();
						closeAddPanel();
						await loadList();
					});
				});
			}

			async function loadList() {
				if (!listEl) return;
				const res = await fetch('/api/admin/recommendations');
				if (!res.ok) {
					listEl.innerHTML = '<p class="form__status form__status--err">Failed to load entries.</p>';
					return;
				}
				itemsCache = await res.json();
				renderList(itemsCache, type, listEl);
			}

			addToggle?.addEventListener('click', () => {
				closeAllEditors();
				if (!addPanel.hidden) {
					closeAddPanel();
					return;
				}
				addPanel.hidden = false;
				addToggle.setAttribute('aria-expanded', 'true');
				setStatus('');
				mountForm(addFormHost, type, null, 'create', () => {
					closeAddPanel();
				});
			});

			loadList();
		</script>
	)
}
