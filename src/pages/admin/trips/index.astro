---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Planisphere from '../../../components/Planisphere.astro';
import { env } from 'cloudflare:workers';
import { isAdminAuthorized } from '../../../lib/auth';
import { listCountriesFromStops } from '../../../lib/countries';
import { PLACE_TYPES, PLACE_TYPE_LABELS, TRANSPORT_MODES, TRANSPORT_MODE_LABELS } from '../../../lib/types';

export const prerender = false;

const authorized = isAdminAuthorized(Astro.request, env);
const preselectId = Astro.url.searchParams.get('trip') || '';
const placeTypeOptions = PLACE_TYPES.map((type) => ({
	value: type,
	label: PLACE_TYPE_LABELS[type],
}));
const transportModeOptions = TRANSPORT_MODES.map((mode) => ({
	value: mode,
	label: TRANSPORT_MODE_LABELS[mode],
}));
const countries = authorized
	? await listCountriesFromStops(env.DB, { publishedOnly: false })
	: [];
---

<BaseLayout title="Admin · Trips" description="Manage travel trips and itineraries." robots="noindex, nofollow">
	<header class="section-head">
		<h1>Admin</h1>
		<p>Manage trips here. Open a trip to edit its stops on a map.</p>
	</header>

	{
		!authorized ? (
			<p class="form__status form__status--err">
				Unauthorized. Locally set <code>ADMIN_DEV_BYPASS=true</code> in <code>.dev.vars</code>.
			</p>
		) : (
			<>
				<nav class="tabs" aria-label="Admin sections">
					<a href="/admin?view=movies">Movies</a>
					<a href="/admin?view=books">Books</a>
					<a href="/admin/trips" aria-current="page">Trips</a>
				</nav>

				<Planisphere
					id="admin-planisphere"
					countries={countries}
					title="Where I've been"
					lead={
						countries.length === 0
							? 'Countries appear here from any trip stop you add (published or draft).'
							: `${countries.length} ${countries.length === 1 ? 'country' : 'countries'} from your trip stops.`
					}
				/>

				<div
					class="admin-layout admin-layout--stack"
					id="trips-app"
					data-preselect={preselectId}
					data-place-types={JSON.stringify(placeTypeOptions)}
					data-transport-modes={JSON.stringify(transportModeOptions)}
				>
					<section class="admin-add admin-add--leading">
						<button class="btn btn--primary" type="button" id="add-trip-toggle" aria-expanded="false">
							Add trip
						</button>
						<div class="admin-expand" id="add-trip-panel" hidden>
							<div id="add-trip-form-host"></div>
						</div>
						<p class="form__status" id="trip-status" role="status" aria-live="polite"></p>
					</section>

					<section class="admin-panel">
						<div class="admin-list" id="trip-list">
							<p class="empty">Loading…</p>
						</div>
					</section>
				</div>
			</>
		)
	}
</BaseLayout>

{
	authorized && (
		<script>
			const app = document.getElementById('trips-app');
			const preselect = app?.dataset.preselect || '';
			/** @type {{ value: string, label: string }[]} */
			const placeTypes = JSON.parse(app?.dataset.placeTypes || '[]');
			/** @type {{ value: string, label: string }[]} */
			const transportModes = JSON.parse(app?.dataset.transportModes || '[]');

			const tripListEl = document.getElementById('trip-list');
			const tripStatusEl = document.getElementById('trip-status');
			const addTripToggle = document.getElementById('add-trip-toggle');
			const addTripPanel = document.getElementById('add-trip-panel');
			const addTripFormHost = document.getElementById('add-trip-form-host');

			const typeLabels = Object.fromEntries(placeTypes.map((t) => [t.value, t.label]));
			const transportLabels = Object.fromEntries(transportModes.map((t) => [t.value, t.label]));

			/** @type {any[]} */
			let tripsCache = [];
			/** @type {Record<string, any[]>} */
			const stopsByTrip = {};
			/** @type {Promise<void> | null} */
			let leafletPromise = null;

			function escapeHtml(value) {
				return String(value)
					.replaceAll('&', '&amp;')
					.replaceAll('<', '&lt;')
					.replaceAll('>', '&gt;')
					.replaceAll('"', '&quot;');
			}

			function flagUrl(code) {
				return `https://flagcdn.com/w40/${String(code).toLowerCase()}.png`;
			}

			async function refreshAdminPlanisphere() {
				const root = document.getElementById('admin-planisphere');
				if (!root) return;
				const res = await fetch('/api/admin/countries');
				if (!res.ok) return;
				/** @type {{ country_code: string, name: string }[]} */
				const countries = await res.json();
				const codes = new Set(countries.map((c) => String(c.country_code).toUpperCase()));

				root.querySelectorAll('[data-planisphere-map] path[id]').forEach((path) => {
					const code = path.id;
					if (!/^[A-Z]{2}$/.test(code)) return;
					path.classList.toggle('is-visited', codes.has(code));
				});

				const lead = root.querySelector('[data-planisphere-lead]');
				if (lead) {
					lead.textContent =
						countries.length === 0
							? 'Countries appear here from any trip stop you add (published or draft).'
							: `${countries.length} ${countries.length === 1 ? 'country' : 'countries'} from your trip stops.`;
				}

				const legend = root.querySelector('[data-planisphere-legend]');
				if (legend) {
					legend.innerHTML = countries
						.map(
							(c) => `
						<li data-legend-code="${escapeHtml(String(c.country_code).toUpperCase())}">
							<img class="planisphere__flag" src="${flagUrl(c.country_code)}" alt="" width="20" height="15" loading="lazy" decoding="async" />
							<strong>${escapeHtml(c.name)}</strong>
							<span class="planisphere__note"> (${escapeHtml(c.country_code)})</span>
						</li>`,
						)
						.join('');
				}
			}

			function setTripStatus(message, ok = true) {
				if (!tripStatusEl) return;
				tripStatusEl.className = `form__status ${ok ? 'form__status--ok' : 'form__status--err'}`;
				tripStatusEl.textContent = message;
			}

			function formatVisit(value) {
				if (!value) return '';
				const dateOnly = String(value).slice(0, 10);
				const date = new Date(`${dateOnly}T12:00:00`);
				if (Number.isNaN(date.getTime())) return dateOnly || value;
				return date.toLocaleDateString(undefined, { dateStyle: 'medium' });
			}

			function ensureLeaflet() {
				if (window.L) return Promise.resolve();
				if (leafletPromise) return leafletPromise;
				leafletPromise = new Promise((resolve, reject) => {
					const link = document.createElement('link');
					link.rel = 'stylesheet';
					link.href = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.css';
					link.crossOrigin = '';
					document.head.appendChild(link);

					const script = document.createElement('script');
					script.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js';
					script.crossOrigin = '';
					script.onload = () => resolve();
					script.onerror = () => reject(new Error('Failed to load map library'));
					document.head.appendChild(script);
				});
				return leafletPromise;
			}

			/** @param {HTMLElement | null} el */
			function destroyLeafletMap(el) {
				if (!el) return;
				const map = el._adminMap;
				if (map) {
					map.remove();
					el._adminMap = null;
				}
			}

			function invalidateSoon(map) {
				requestAnimationFrame(() => map.invalidateSize());
				setTimeout(() => map.invalidateSize(), 120);
			}

			/**
			 * @param {HTMLElement} mapEl
			 * @param {{ lat: number, lng: number, name?: string }[]} stops
			 */
			async function mountOverviewMap(mapEl, stops) {
				await ensureLeaflet();
				destroyLeafletMap(mapEl);
				mapEl.innerHTML = '';

				const L = window.L;
				const map = L.map(mapEl, { scrollWheelZoom: false });
				L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
					attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
					maxZoom: 19,
				}).addTo(map);

				const mappable = stops.filter((s) => s.lat != null && s.lng != null);
				if (!mappable.length) {
					map.setView([20, 0], 2);
				} else {
					const bounds = [];
					mappable.forEach((stop) => {
						const marker = L.marker([stop.lat, stop.lng], { title: stop.name }).addTo(map);
						if (stop.name) marker.bindPopup(`<strong>${escapeHtml(stop.name)}</strong>`);
						bounds.push([stop.lat, stop.lng]);
					});
					if (bounds.length === 1) map.setView(bounds[0], 13);
					else map.fitBounds(bounds, { padding: [36, 36] });
				}

				mapEl._adminMap = map;
				invalidateSoon(map);
				return map;
			}

			/**
			 * Click-to-place / drag pin picker. Writes hidden lat/lng inputs.
			 * @param {HTMLElement} host
			 * @param {{ lat?: number | null, lng?: number | null }} seed
			 */
			async function mountMapPicker(host, seed) {
				await ensureLeaflet();
				const mapEl = host.querySelector('.admin-map-picker__map');
				const coordsEl = host.querySelector('.admin-map-picker__coords');
				const latInput = host.querySelector('[name="lat"]');
				const lngInput = host.querySelector('[name="lng"]');
				const clearBtn = host.querySelector('[data-action="clear-pin"]');
				if (!mapEl || !coordsEl || !latInput || !lngInput) {
					return { setPinFromCoords: () => {} };
				}

				destroyLeafletMap(mapEl);
				mapEl.innerHTML = '';

				const L = window.L;
				const map = L.map(mapEl, { scrollWheelZoom: true });
				L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
					attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
					maxZoom: 19,
				}).addTo(map);

				/** @type {any} */
				let marker = null;

				function updateFields(lat, lng) {
					latInput.value = String(lat);
					lngInput.value = String(lng);
					coordsEl.textContent = `${Number(lat).toFixed(5)}, ${Number(lng).toFixed(5)}`;
				}

				function clearPin() {
					if (marker) {
						map.removeLayer(marker);
						marker = null;
					}
					latInput.value = '';
					lngInput.value = '';
					coordsEl.textContent = 'No pin set';
				}

				function setPin(latlng) {
					if (!marker) {
						marker = L.marker(latlng, { draggable: true }).addTo(map);
						marker.on('dragend', () => {
							const p = marker.getLatLng();
							updateFields(p.lat, p.lng);
						});
					} else {
						marker.setLatLng(latlng);
					}
					updateFields(latlng.lat, latlng.lng);
				}

				/**
				 * @param {number} lat
				 * @param {number} lng
				 * @param {number} [zoom]
				 */
				function setPinFromCoords(lat, lng, zoom = 14) {
					const latlng = L.latLng(lat, lng);
					setPin(latlng);
					map.setView(latlng, zoom);
					invalidateSoon(map);
				}

				map.on('click', (event) => setPin(event.latlng));
				clearBtn?.addEventListener('click', clearPin);

				const seedLat = seed.lat != null ? Number(seed.lat) : NaN;
				const seedLng = seed.lng != null ? Number(seed.lng) : NaN;
				if (!Number.isNaN(seedLat) && !Number.isNaN(seedLng)) {
					setPin(L.latLng(seedLat, seedLng));
					map.setView([seedLat, seedLng], 13);
				} else {
					clearPin();
					map.setView([20, 0], 2);
				}

				mapEl._adminMap = map;
				invalidateSoon(map);
				return { setPinFromCoords };
			}

			function closeAddTripPanel() {
				if (!addTripPanel || !addTripToggle || !addTripFormHost) return;
				addTripPanel.hidden = true;
				addTripFormHost.innerHTML = '';
				addTripToggle.setAttribute('aria-expanded', 'false');
				addTripToggle.textContent = 'Add trip';
			}

			function openAddTripPanel() {
				if (!addTripPanel || !addTripToggle || !addTripFormHost) return;
				closeAllTripEditors();
				addTripPanel.hidden = false;
				addTripToggle.setAttribute('aria-expanded', 'true');
				addTripToggle.textContent = 'Cancel';
				setTripStatus('');
				mountTripForm(addTripFormHost, null, 'create', () => closeAddTripPanel());
				addTripPanel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
			}

			/**
			 * @param {string} tripId
			 * @param {number} stopCount
			 */
			function syncTripStopCount(tripId, stopCount) {
				const trip = tripsCache.find((t) => t.id === tripId);
				if (trip) trip.stop_count = stopCount;
				const block = document.querySelector(`.admin-trip-block[data-id="${CSS.escape(tripId)}"]`);
				if (!block) return;
				const card = block.querySelector('.admin-trip-card');
				if (!card) return;

				const draft = trip && !trip.published;
				const stopMeta = `${stopCount} stop${stopCount === 1 ? '' : 's'}`;
				const metaHtml = draft
					? `${escapeHtml(stopMeta)} · <span class="badge badge--draft">draft</span>`
					: escapeHtml(stopMeta);

				let meta = card.querySelector('.rec-item__meta');
				if (!meta) {
					meta = document.createElement('p');
					meta.className = 'rec-item__meta';
					const title = card.querySelector('.rec-item__title');
					if (title) card.insertBefore(meta, title);
					else card.prepend(meta);
				}
				meta.innerHTML = metaHtml;
			}

			/**
			 * @param {string} tripId
			 * @param {{ openAddStop?: boolean, scroll?: boolean }} [opts]
			 */
			async function openManageStops(tripId, opts = {}) {
				const { openAddStop = false, scroll = true } = opts;
				closeAddTripPanel();
				const already =
					document.querySelector(`.admin-trip-block[data-id="${CSS.escape(tripId)}"].is-managing`) !=
					null;
				closeAllTripEditors();
				if (already && !openAddStop) return;

				const block = document.querySelector(`.admin-trip-block[data-id="${CSS.escape(tripId)}"]`);
				const editor = block?.querySelector('.admin-row__editor');
				if (!block || !editor) return;

				block.classList.add('is-managing');
				history.replaceState({}, '', `/admin/trips?trip=${encodeURIComponent(tripId)}`);
				await mountManagePanel(editor, tripId, { openAddStop });
				if (scroll) {
					block.scrollIntoView({ behavior: 'smooth', block: 'start' });
				}
			}

			function closeAllTripEditors() {
				document.querySelectorAll('.admin-trip-block .admin-row__editor').forEach((el) => {
					el.querySelectorAll('.admin-map-picker__map, .admin-stops__map').forEach((mapEl) =>
						destroyLeafletMap(mapEl),
					);
					el.hidden = true;
					el.innerHTML = '';
				});
				document.querySelectorAll('.admin-trip-block.is-editing, .admin-trip-block.is-managing').forEach((el) => {
					el.classList.remove('is-editing', 'is-managing');
				});
				if (new URL(location.href).searchParams.has('trip')) {
					history.replaceState({}, '', '/admin/trips');
				}
			}

			function placeTypeOptionsHtml(selected) {
				return placeTypes
					.map(
						(t) =>
							`<option value="${escapeHtml(t.value)}"${t.value === selected ? ' selected' : ''}>${escapeHtml(t.label)}</option>`,
					)
					.join('');
			}

			function transportModeOptionsHtml(selected) {
				return transportModes
					.map(
						(t) =>
							`<option value="${escapeHtml(t.value)}"${t.value === selected ? ' selected' : ''}>${escapeHtml(t.label)}</option>`,
					)
					.join('');
			}

			/**
			 * @param {any | null} trip
			 * @param {'create' | 'edit'} mode
			 */
			function buildTripFormHtml(trip, mode) {
				const id = trip?.id || '';
				const title = escapeHtml(trip?.title || '');
				const summary = escapeHtml(trip?.summary || '');
				const image = escapeHtml(trip?.image_url || '');
				const published = !trip || trip.published === 1;
				const canPickStopCover = mode === 'edit' && Boolean(id);
				return `
					<form class="form admin-entry-form" data-mode="${mode}">
						<input type="hidden" name="id" value="${escapeHtml(id)}" />
						<label>
							Trip title
							<input type="text" name="title" required maxlength="200" placeholder="Lisbon" value="${title}" />
						</label>
						<label>
							Summary
							<textarea name="summary" required maxlength="4000">${summary}</textarea>
						</label>
						<label>
							Cover image URL
							<input type="text" name="image_url" maxlength="500" placeholder="https://… or /media/…" value="${image}" data-cover-url />
						</label>
						<div class="admin-cover-tools">
							<button class="btn btn--ghost" type="button" data-action="fetch-cover">Fetch photo (Unsplash)</button>
							<p class="form__status" data-cover-status role="status" aria-live="polite"></p>
						</div>
						${
							canPickStopCover
								? `
						<div class="admin-stop-cover" data-stop-cover>
							<p class="admin-map-picker__label">Or use a stop photo</p>
							<p class="admin-map-picker__hint">Photos you’ve uploaded on this trip’s stops. Click one to set the cover.</p>
							<div class="admin-cover__grid" data-stop-cover-grid></div>
							<p class="admin-map-picker__hint" data-stop-cover-empty hidden>No stop photos yet — upload one while managing stops, then come back here.</p>
						</div>`
								: `<p class="admin-map-picker__hint">After you add stops with photos, edit the trip to use one as the cover.</p>`
						}
						<img class="admin-cover-preview" data-cover-preview alt="" ${image ? `src="${image}"` : 'hidden'} width="210" height="140" />
						<label class="checkbox-row">
							<input type="checkbox" name="published" ${published ? 'checked' : ''} />
							Published
						</label>
						<div class="form__actions">
							<button class="btn btn--primary" type="submit">${mode === 'edit' ? 'Save changes' : 'Create trip'}</button>
							<button class="btn btn--ghost" type="button" data-action="cancel">Cancel</button>
						</div>
					</form>
				`;
			}

			/**
			 * @param {any | null} item
			 * @param {'create' | 'edit'} mode
			 */
			function buildStopFormHtml(item, mode) {
				const id = item?.id || '';
				const place = escapeHtml(item?.place_name || '');
				const countryCode = escapeHtml(item?.country_code || '');
				const countryName = escapeHtml(item?.country_name || '');
				const visited = escapeHtml((item?.visited_at || '').slice(0, 10));
				const transit = escapeHtml(item?.how_i_got_there || '');
				const notes = escapeHtml(item?.notes || '');
				const url = escapeHtml(item?.url || '');
				const order = item?.sort_order != null ? String(item.sort_order) : '';
				const selectedType = item?.place_type || placeTypes[0]?.value || 'other';
				const selectedTransport = item?.transport_mode || 'other';
				const lat = item?.lat != null ? String(item.lat) : '';
				const lng = item?.lng != null ? String(item.lng) : '';
				const image = escapeHtml(item?.image_url || '');
				const canUpload = mode === 'edit' && Boolean(item?.id);

				return `
					<form class="form admin-entry-form" data-mode="${mode}">
						<input type="hidden" name="id" value="${escapeHtml(id)}" />
						<input type="hidden" name="lat" value="${escapeHtml(lat)}" />
						<input type="hidden" name="lng" value="${escapeHtml(lng)}" />
						<div class="admin-place-search" data-place-search>
							<label>
								Search place (map)
								<input type="search" data-place-query maxlength="200" placeholder="e.g. Alfama, Lisbon" autocomplete="off" />
							</label>
							<p class="admin-map-picker__hint">
								Uses Google Places when <code>GOOGLE_MAPS_API_KEY</code> is set; otherwise OpenStreetMap Nominatim.
							</p>
							<ul class="admin-place-search__results" data-place-results hidden></ul>
							<p class="form__status" data-place-status role="status" aria-live="polite"></p>
						</div>
						<label>
							Place / destination
							<input type="text" name="place_name" required maxlength="200" value="${place}" />
						</label>
						<div class="form-grid-2">
							<label>
								Country code (ISO)
								<input type="text" name="country_code" required maxlength="2" placeholder="PT" pattern="[A-Za-z]{2}" value="${countryCode}" />
							</label>
							<label>
								Country name
								<input type="text" name="country_name" required maxlength="120" placeholder="Portugal" value="${countryName}" />
							</label>
						</div>
						<label>
							Place type
							<select name="place_type" required>${placeTypeOptionsHtml(selectedType)}</select>
						</label>
						<label>
							Date of visit
							<input type="date" name="visited_at" required value="${visited}" />
						</label>
						<label>
							How I got there (mode)
							<select name="transport_mode" required>${transportModeOptionsHtml(selectedTransport)}</select>
						</label>
						<label>
							Transport details (optional)
							<input type="text" name="how_i_got_there" maxlength="500" placeholder="Tram 28, walked from Baixa…" value="${transit}" />
						</label>
						<label>
							Notes (optional)
							<textarea name="notes" maxlength="2000">${notes}</textarea>
						</label>
						<label>
							URL (optional)
							<input type="url" name="url" maxlength="500" placeholder="https://" value="${url}" />
						</label>
						<label>
							Sort order
							<input type="number" name="sort_order" min="0" step="1" placeholder="Auto" value="${escapeHtml(order)}" />
						</label>
						${
							canUpload
								? `
						<div class="admin-stop-photo" data-stop-photo>
							<p class="admin-map-picker__label">Stop photo</p>
							<p class="admin-map-picker__hint">JPEG/PNG/WebP · resized to 1600px · max ~1.5MB</p>
							<img class="admin-cover-preview" data-stop-photo-preview alt="" ${image ? `src="${image}"` : 'hidden'} width="240" height="160" />
							<input type="file" accept="image/jpeg,image/png,image/webp" data-stop-photo-file />
							<div class="form__actions">
								<button class="btn btn--ghost" type="button" data-action="upload-photo">Upload photo</button>
								<button class="btn btn--ghost" type="button" data-action="remove-photo" ${image ? '' : 'hidden'}>Remove photo</button>
							</div>
							<p class="form__status" data-photo-status role="status" aria-live="polite"></p>
						</div>`
								: `<p class="admin-map-picker__hint">Save this stop first, then edit it to upload a photo.</p>`
						}
						<div class="admin-map-picker">
							<p class="admin-map-picker__label">Map pin</p>
							<p class="admin-map-picker__hint">Click the map to place the pin. Drag to adjust.</p>
							<div class="admin-map-picker__map trip-map" role="application" aria-label="Choose stop location"></div>
							<div class="admin-map-picker__meta">
								<p class="admin-map-picker__coords" aria-live="polite">No pin set</p>
								<button class="btn btn--ghost" type="button" data-action="clear-pin">Clear pin</button>
							</div>
						</div>
						<div class="form__actions">
							<button class="btn btn--primary" type="submit">${mode === 'edit' ? 'Save stop' : 'Add stop'}</button>
							<button class="btn btn--ghost" type="button" data-action="cancel">Cancel</button>
							<p class="form__status" data-stop-status role="status" aria-live="polite"></p>
						</div>
					</form>
				`;
			}

			/**
			 * @param {HTMLFormElement} form
			 */
			function tripPayloadFromForm(form) {
				const data = new FormData(form);
				return {
					title: String(data.get('title') || ''),
					summary: String(data.get('summary') || ''),
					image_url: String(data.get('image_url') || '') || null,
					published: form.querySelector('[name="published"]')?.checked === true,
				};
			}

			/**
			 * @param {HTMLFormElement} form
			 */
			function stopPayloadFromForm(form) {
				const data = new FormData(form);
				const orderRaw = String(data.get('sort_order') || '').trim();
				const latRaw = String(data.get('lat') || '').trim();
				const lngRaw = String(data.get('lng') || '').trim();
				const payload = {
					place_name: String(data.get('place_name') || ''),
					country_code: String(data.get('country_code') || ''),
					country_name: String(data.get('country_name') || ''),
					place_type: String(data.get('place_type') || ''),
					transport_mode: String(data.get('transport_mode') || 'other'),
					visited_at: String(data.get('visited_at') || ''),
					how_i_got_there: String(data.get('how_i_got_there') || ''),
					notes: String(data.get('notes') || '') || null,
					url: String(data.get('url') || '') || null,
					lat: latRaw === '' ? null : Number(latRaw),
					lng: lngRaw === '' ? null : Number(lngRaw),
				};
				if (orderRaw !== '') payload.sort_order = Number(orderRaw);
				return payload;
			}

			/**
			 * Resize image in-browser before upload (max 1600px, JPEG ~0.82).
			 * @param {File} file
			 * @returns {Promise<Blob>}
			 */
			async function resizeImageForUpload(file) {
				const bitmap = await createImageBitmap(file);
				const maxEdge = 1600;
				const scale = Math.min(1, maxEdge / Math.max(bitmap.width, bitmap.height));
				const width = Math.max(1, Math.round(bitmap.width * scale));
				const height = Math.max(1, Math.round(bitmap.height * scale));
				const canvas = document.createElement('canvas');
				canvas.width = width;
				canvas.height = height;
				const ctx = canvas.getContext('2d');
				if (!ctx) throw new Error('Canvas unavailable');
				ctx.drawImage(bitmap, 0, 0, width, height);
				bitmap.close();
				const type = file.type === 'image/png' || file.type === 'image/webp' ? file.type : 'image/jpeg';
				const quality = type === 'image/jpeg' ? 0.82 : undefined;
				const blob = await new Promise((resolve, reject) => {
					canvas.toBlob(
						(result) => (result ? resolve(result) : reject(new Error('Resize failed'))),
						type,
						quality,
					);
				});
				return blob;
			}

			/**
			 * @param {HTMLElement} host
			 * @param {any | null} trip
			 * @param {'create' | 'edit'} mode
			 * @param {() => void} onCancel
			 */
			function mountTripForm(host, trip, mode, onCancel) {
				host.innerHTML = buildTripFormHtml(trip, mode);
				const form = host.querySelector('form');
				const coverInput = form?.querySelector('[data-cover-url]');
				const coverPreview = form?.querySelector('[data-cover-preview]');
				const coverStatus = form?.querySelector('[data-cover-status]');
				const stopCoverGrid = form?.querySelector('[data-stop-cover-grid]');
				const stopCoverEmpty = form?.querySelector('[data-stop-cover-empty]');

				function setCoverStatus(message, ok = true) {
					if (!coverStatus) return;
					coverStatus.className = `form__status ${ok ? 'form__status--ok' : 'form__status--err'}`;
					coverStatus.textContent = message;
				}

				function syncCoverPreview(url) {
					if (!(coverPreview instanceof HTMLImageElement)) return;
					const next = String(url || '').trim();
					if (!next) {
						coverPreview.hidden = true;
						coverPreview.removeAttribute('src');
						return;
					}
					coverPreview.hidden = false;
					coverPreview.src = next;
				}

				function markStopCoverSelection(url) {
					if (!(stopCoverGrid instanceof HTMLElement)) return;
					const current = String(url || '').trim();
					stopCoverGrid.querySelectorAll('[data-stop-cover-url]').forEach((btn) => {
						btn.classList.toggle('is-selected', btn.getAttribute('data-stop-cover-url') === current);
					});
				}

				async function loadStopCoverChoices() {
					if (!(stopCoverGrid instanceof HTMLElement) || !trip?.id) return;
					try {
						const stops = await loadStops(trip.id);
						const withPhotos = stops.filter((s) => String(s.image_url || '').trim());
						if (!withPhotos.length) {
							stopCoverGrid.innerHTML = '';
							stopCoverEmpty?.removeAttribute('hidden');
							return;
						}
						stopCoverEmpty?.setAttribute('hidden', '');
						stopCoverGrid.innerHTML = withPhotos
							.map(
								(stop) => `
							<button
								type="button"
								class="admin-cover__choice admin-stop-cover__choice"
								data-stop-cover-url="${escapeHtml(stop.image_url)}"
								title="${escapeHtml(stop.place_name)}"
							>
								<img src="${escapeHtml(stop.image_url)}" alt="" width="120" height="80" loading="lazy" decoding="async" />
								<span class="admin-stop-cover__label">${escapeHtml(stop.place_name)}</span>
							</button>`,
							)
							.join('');
						markStopCoverSelection(coverInput instanceof HTMLInputElement ? coverInput.value : '');
						stopCoverGrid.querySelectorAll('[data-stop-cover-url]').forEach((btn) => {
							btn.addEventListener('click', () => {
								const url = btn.getAttribute('data-stop-cover-url') || '';
								if (coverInput instanceof HTMLInputElement) coverInput.value = url;
								syncCoverPreview(url);
								markStopCoverSelection(url);
								setCoverStatus(`Using photo from “${btn.getAttribute('title') || 'stop'}”. Save the trip to keep this cover.`);
							});
						});
					} catch {
						stopCoverGrid.innerHTML = '';
						if (stopCoverEmpty) {
							stopCoverEmpty.hidden = false;
							stopCoverEmpty.textContent = 'Could not load stop photos.';
						}
					}
				}

				coverInput?.addEventListener('input', () => {
					const value = coverInput instanceof HTMLInputElement ? coverInput.value : '';
					syncCoverPreview(value);
					markStopCoverSelection(value);
				});

				form?.querySelector('[data-action="fetch-cover"]')?.addEventListener('click', async () => {
					if (!(form instanceof HTMLFormElement)) return;
					const data = new FormData(form);
					setCoverStatus('Looking up photo…');
					const res = await fetch('/api/admin/trip-covers', {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify({ query: String(data.get('title') || '') }),
					});
					const json = await res.json();
					if (!res.ok) {
						setCoverStatus(json.error || 'Photo lookup failed.', false);
						return;
					}
					if (coverInput instanceof HTMLInputElement) {
						coverInput.value = json.image_url;
					}
					syncCoverPreview(json.image_url);
					markStopCoverSelection(json.image_url);
					setCoverStatus(`Matched “${json.matched_title}”. Save the trip to keep this cover.`);
				});

				form?.querySelector('[data-action="cancel"]')?.addEventListener('click', onCancel);
				form?.addEventListener('submit', async (event) => {
					event.preventDefault();
					const editingId = String(new FormData(form).get('id') || '');
					const payload = tripPayloadFromForm(form);
					const res = await fetch(editingId ? `/api/admin/trips/${editingId}` : '/api/admin/trips', {
						method: editingId ? 'PUT' : 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify(payload),
					});
					const json = await res.json();
					if (!res.ok) {
						setTripStatus(json.error || 'Save failed.', false);
						return;
					}
					setTripStatus(editingId ? 'Trip updated.' : 'Trip created.');
					onCancel();
					await loadTrips();
					if (!editingId && json.id) {
						await openManageStops(json.id, { openAddStop: true, scroll: true });
					}
				});

				void loadStopCoverChoices();
			}

			/**
			 * @param {HTMLElement} host
			 * @param {{ setPinFromCoords: (lat: number, lng: number, zoom?: number) => void }} mapApi
			 */
			function mountPlaceSearch(host, mapApi) {
				const queryInput = host.querySelector('[data-place-query]');
				const resultsEl = host.querySelector('[data-place-results]');
				const statusEl = host.querySelector('[data-place-status]');
				const placeInput = host.querySelector('[name="place_name"]');
				const countryCodeInput = host.querySelector('[name="country_code"]');
				const countryNameInput = host.querySelector('[name="country_name"]');
				if (!(queryInput instanceof HTMLInputElement) || !(resultsEl instanceof HTMLElement)) return;

				/** @type {ReturnType<typeof setTimeout> | null} */
				let debounceTimer = null;
				/** @type {AbortController | null} */
				let abortCtrl = null;

				function setPlaceStatus(message, ok = true) {
					if (!statusEl) return;
					statusEl.className = `form__status ${ok ? 'form__status--ok' : 'form__status--err'}`;
					statusEl.textContent = message;
				}

				function clearResults() {
					resultsEl.innerHTML = '';
					resultsEl.hidden = true;
				}

				/**
				 * @param {any} hit
				 */
				function applyHit(hit) {
					if (placeInput instanceof HTMLInputElement) placeInput.value = hit.placeName || '';
					if (countryCodeInput instanceof HTMLInputElement) {
						countryCodeInput.value = hit.countryCode || '';
					}
					if (countryNameInput instanceof HTMLInputElement) {
						countryNameInput.value = hit.countryName || '';
					}
					mapApi.setPinFromCoords(hit.lat, hit.lng, 14);
					clearResults();
					setPlaceStatus('Filled from map search — adjust fields if needed.');
					queryInput.value = hit.placeName || '';
				}

				/**
				 * @param {any[]} hits
				 */
				function renderResults(hits) {
					if (!hits.length) {
						clearResults();
						setPlaceStatus('No places found.', false);
						return;
					}
					resultsEl.hidden = false;
					resultsEl.innerHTML = hits
						.map(
							(hit, index) => `
						<li>
							<button type="button" class="admin-place-search__hit" data-place-index="${index}">
								<span class="admin-place-search__hit-name">${escapeHtml(hit.placeName)}</span>
								<span class="admin-place-search__hit-detail">${escapeHtml(hit.displayName)}</span>
							</button>
						</li>`,
						)
						.join('');
					resultsEl.querySelectorAll('[data-place-index]').forEach((btn) => {
						btn.addEventListener('click', () => {
							const index = Number(btn.getAttribute('data-place-index'));
							const hit = hits[index];
							if (hit) applyHit(hit);
						});
					});
					setPlaceStatus(`${hits.length} place${hits.length === 1 ? '' : 's'} — pick one.`);
				}

				async function runSearch(q) {
					abortCtrl?.abort();
					abortCtrl = new AbortController();
					setPlaceStatus('Searching…');
					try {
						const res = await fetch(`/api/admin/geocode?q=${encodeURIComponent(q)}`, {
							signal: abortCtrl.signal,
						});
						const json = await res.json();
						if (!res.ok) {
							clearResults();
							setPlaceStatus(json.error || 'Place search failed.', false);
							return;
						}
						renderResults(json.results || []);
					} catch (err) {
						if (err instanceof DOMException && err.name === 'AbortError') return;
						clearResults();
						setPlaceStatus('Place search failed.', false);
					}
				}

				queryInput.addEventListener('input', () => {
					const q = queryInput.value.trim();
					if (debounceTimer) clearTimeout(debounceTimer);
					if (q.length < 2) {
						clearResults();
						setPlaceStatus('');
						return;
					}
					debounceTimer = setTimeout(() => runSearch(q), 350);
				});
			}

			/**
			 * @param {HTMLElement} host
			 * @param {string} tripId
			 * @param {any | null} item
			 * @param {'create' | 'edit'} mode
			 * @param {() => void} onDone
			 */
			function mountStopForm(host, tripId, item, mode, onDone) {
				host.innerHTML = buildStopFormHtml(item, mode);
				const form = host.querySelector('form');
				const statusEl = host.querySelector('[data-stop-status]');
				const photoStatus = host.querySelector('[data-photo-status]');
				const photoPreview = host.querySelector('[data-stop-photo-preview]');
				const photoFile = host.querySelector('[data-stop-photo-file]');
				const removePhotoBtn = host.querySelector('[data-action="remove-photo"]');

				function setStopStatus(message, ok = true) {
					if (!statusEl) return;
					statusEl.className = `form__status ${ok ? 'form__status--ok' : 'form__status--err'}`;
					statusEl.textContent = message;
				}

				function setPhotoStatus(message, ok = true) {
					if (!photoStatus) return;
					photoStatus.className = `form__status ${ok ? 'form__status--ok' : 'form__status--err'}`;
					photoStatus.textContent = message;
				}

				function syncPhotoPreview(url) {
					if (!(photoPreview instanceof HTMLImageElement)) return;
					const next = String(url || '').trim();
					if (!next) {
						photoPreview.hidden = true;
						photoPreview.removeAttribute('src');
						removePhotoBtn?.setAttribute('hidden', '');
						return;
					}
					photoPreview.hidden = false;
					photoPreview.src = next;
					removePhotoBtn?.removeAttribute('hidden');
				}

				form?.querySelector('[data-action="cancel"]')?.addEventListener('click', onDone);
				void (async () => {
					const mapApi = await mountMapPicker(host, { lat: item?.lat ?? null, lng: item?.lng ?? null });
					mountPlaceSearch(host, mapApi);
				})();

				form?.querySelector('[data-action="upload-photo"]')?.addEventListener('click', async () => {
					const stopId = String(new FormData(form).get('id') || '');
					const file =
						photoFile instanceof HTMLInputElement && photoFile.files?.[0]
							? photoFile.files[0]
							: null;
					if (!stopId) {
						setPhotoStatus('Save the stop before uploading a photo.', false);
						return;
					}
					if (!file) {
						setPhotoStatus('Choose an image file first.', false);
						return;
					}
					try {
						setPhotoStatus('Resizing and uploading…');
						const blob = await resizeImageForUpload(file);
						if (blob.size > 1.5 * 1024 * 1024) {
							setPhotoStatus('Image is still over 1.5MB after resize. Try a smaller file.', false);
							return;
						}
						const body = new FormData();
						body.append('file', blob, file.name || 'stop.jpg');
						const res = await fetch(`/api/admin/itinerary/${stopId}/image`, {
							method: 'POST',
							body,
						});
						const json = await res.json();
						if (!res.ok) {
							setPhotoStatus(json.error || 'Upload failed.', false);
							return;
						}
						syncPhotoPreview(json.image_url);
						setPhotoStatus('Photo uploaded.');
						await loadStops(tripId);
					} catch (err) {
						setPhotoStatus(err instanceof Error ? err.message : 'Upload failed.', false);
					}
				});

				removePhotoBtn?.addEventListener('click', async () => {
					const stopId = String(new FormData(form).get('id') || '');
					if (!stopId) return;
					const res = await fetch(`/api/admin/itinerary/${stopId}/image`, { method: 'DELETE' });
					const json = await res.json();
					if (!res.ok) {
						setPhotoStatus(json.error || 'Remove failed.', false);
						return;
					}
					syncPhotoPreview('');
					if (photoFile instanceof HTMLInputElement) photoFile.value = '';
					setPhotoStatus('Photo removed.');
					await loadStops(tripId);
				});

				form?.addEventListener('submit', async (event) => {
					event.preventDefault();
					const editingId = String(new FormData(form).get('id') || '');
					const payload = stopPayloadFromForm(form);
					const res = await fetch(
						editingId ? `/api/admin/itinerary/${editingId}` : `/api/admin/trips/${tripId}/itinerary`,
						{
							method: editingId ? 'PUT' : 'POST',
							headers: { 'Content-Type': 'application/json' },
							body: JSON.stringify(payload),
						},
					);
					const json = await res.json();
					if (!res.ok) {
						setStopStatus(json.error || 'Save failed.', false);
						return;
					}
					setTripStatus(editingId ? 'Stop updated.' : 'Stop added.');
					onDone();
					await refreshManagePanel(tripId);
					await refreshAdminPlanisphere();
					const stops = stopsByTrip[tripId] || [];
					syncTripStopCount(tripId, stops.length);
				});
			}

			async function loadStops(tripId) {
				const res = await fetch(`/api/admin/trips/${tripId}`);
				if (!res.ok) {
					stopsByTrip[tripId] = [];
					throw new Error('Failed to load stops');
				}
				const data = await res.json();
				stopsByTrip[tripId] = data.items || [];
				return stopsByTrip[tripId];
			}

			/**
			 * @param {HTMLElement} listEl
			 * @param {string} tripId
			 * @param {any[]} stops
			 */
			function renderStopList(listEl, tripId, stops) {
				if (!stops.length) {
					listEl.innerHTML = '<p class="empty">No stops yet.</p>';
					return;
				}

				listEl.innerHTML = stops
					.map(
						(item) => `
					<div class="admin-row-block admin-stop-block" data-stop-id="${escapeHtml(item.id)}">
						<div class="admin-row">
							<div class="admin-row__title">${escapeHtml(item.place_name)}</div>
							<div class="admin-row__meta">
								${formatVisit(item.visited_at)} · ${escapeHtml(item.country_name || item.country_code || '')}
								· #${item.sort_order} · ${escapeHtml(typeLabels[item.place_type] || item.place_type)}
								· ${escapeHtml(transportLabels[item.transport_mode] || item.transport_mode || 'Other')}${
									item.how_i_got_there ? ` · ${escapeHtml(item.how_i_got_there)}` : ''
								}${
									item.lat != null && item.lng != null ? ' · on map' : ''
								}
							</div>
							<div class="admin-row__actions">
								<button class="btn btn--ghost" type="button" data-action="edit-stop">Edit</button>
								<button class="btn btn--danger" type="button" data-action="delete-stop">Delete</button>
							</div>
						</div>
						<div class="admin-row__editor admin-expand" hidden></div>
					</div>`,
					)
					.join('');

				listEl.querySelectorAll('.admin-stop-block').forEach((block) => {
					const stopId = block.dataset.stopId;
					const item = stops.find((s) => s.id === stopId);
					if (!item) return;

					block.querySelector('[data-action="edit-stop"]')?.addEventListener('click', () => {
						const stopsRoot = listEl.closest('.admin-stops');
						closeStopEditors(listEl);
						closeAddStopPanel(stopsRoot);
						const already = block.classList.contains('is-editing');
						if (already) return;
						block.classList.add('is-editing');
						stopsRoot?.classList.add('is-editing-stop');
						const editor = block.querySelector('.admin-row__editor');
						if (!editor) return;
						editor.hidden = false;
						mountStopForm(editor, tripId, item, 'edit', () => {
							closeStopEditors(listEl);
							stopsRoot?.classList.remove('is-editing-stop');
						});
					});

					block.querySelector('[data-action="delete-stop"]')?.addEventListener('click', async () => {
						if (!confirm(`Delete “${item.place_name}”?`)) return;
						const del = await fetch(`/api/admin/itinerary/${stopId}`, { method: 'DELETE' });
						if (!del.ok) {
							setTripStatus('Delete failed.', false);
							return;
						}
						setTripStatus('Stop deleted.');
						await refreshManagePanel(tripId);
						await refreshAdminPlanisphere();
						const stops = stopsByTrip[tripId] || [];
						syncTripStopCount(tripId, stops.length);
					});
				});
			}

			/** @param {HTMLElement} listEl */
			function closeStopEditors(listEl) {
				listEl.querySelectorAll('.admin-stop-block .admin-row__editor').forEach((el) => {
					el.querySelectorAll('.admin-map-picker__map').forEach((mapEl) => destroyLeafletMap(mapEl));
					el.hidden = true;
					el.innerHTML = '';
				});
				listEl.querySelectorAll('.admin-stop-block.is-editing').forEach((el) => {
					el.classList.remove('is-editing');
				});
				listEl.closest('.admin-stops')?.classList.remove('is-editing-stop');
			}

			/** @param {HTMLElement | null} stopsRoot */
			function closeAddStopPanel(stopsRoot) {
				if (!stopsRoot) return;
				const panel = stopsRoot.querySelector('[data-add-stop-panel]');
				const toggle = stopsRoot.querySelector('[data-add-stop-toggle]');
				const host = stopsRoot.querySelector('[data-add-stop-host]');
				if (host) {
					host.querySelectorAll('.admin-map-picker__map').forEach((mapEl) => destroyLeafletMap(mapEl));
					host.innerHTML = '';
				}
				if (panel) panel.hidden = true;
				toggle?.setAttribute('aria-expanded', 'false');
				if (toggle) toggle.textContent = 'Add stop';
			}

			async function refreshManagePanel(tripId) {
				const block = document.querySelector(`.admin-trip-block[data-id="${CSS.escape(tripId)}"]`);
				if (!block || !block.classList.contains('is-managing')) return;
				const editor = block.querySelector('.admin-row__editor');
				if (!editor) return;
				await mountManagePanel(editor, tripId);
			}

			/**
			 * @param {HTMLElement} editor
			 * @param {string} tripId
			 * @param {{ openAddStop?: boolean }} [opts]
			 */
			async function mountManagePanel(editor, tripId, opts = {}) {
				const { openAddStop = false } = opts;
				editor.querySelectorAll('.admin-map-picker__map, .admin-stops__map').forEach((mapEl) =>
					destroyLeafletMap(mapEl),
				);

				let stops = [];
				try {
					stops = await loadStops(tripId);
				} catch {
					editor.innerHTML = '<p class="form__status form__status--err">Failed to load stops.</p>';
					return;
				}

				syncTripStopCount(tripId, stops.length);

				editor.hidden = false;
				editor.innerHTML = `
					<div class="admin-stops">
						<div class="admin-stops__map trip-map" data-overview-map role="application" aria-label="Trip stops map"></div>
						<p class="admin-stops__hint">Pins mark stops with a location. Edit a stop to move its pin.</p>
						<div class="admin-stops__body" data-stops-body>
							<div class="admin-list" data-stop-list></div>
							<section class="admin-add">
								<div class="admin-stops__actions">
									<button class="btn btn--primary" type="button" data-add-stop-toggle aria-expanded="false">Add stop</button>
									<button class="btn btn--ghost" type="button" data-collapse-stops>Close</button>
								</div>
								<div class="admin-expand" data-add-stop-panel hidden>
									<div data-add-stop-host></div>
								</div>
							</section>
						</div>
					</div>
				`;

				const overviewEl = editor.querySelector('[data-overview-map]');
				const listEl = editor.querySelector('[data-stop-list]');
				const addToggle = editor.querySelector('[data-add-stop-toggle]');
				const addPanel = editor.querySelector('[data-add-stop-panel]');
				const addHost = editor.querySelector('[data-add-stop-host]');
				const closeBtn = editor.querySelector('[data-collapse-stops]');

				if (listEl) renderStopList(listEl, tripId, stops);

				if (overviewEl) {
					try {
						await mountOverviewMap(
							overviewEl,
							stops.map((s) => ({ lat: s.lat, lng: s.lng, name: s.place_name })),
						);
					} catch {
						overviewEl.innerHTML =
							'<p class="form__status form__status--err">Map failed to load. Stops still listed below.</p>';
					}
				}

				closeBtn?.addEventListener('click', () => {
					closeAllTripEditors();
				});

				const openAddStopPanel = () => {
					if (!listEl || !addPanel || !addHost || !addToggle) return;
					closeStopEditors(listEl);
					addPanel.hidden = false;
					addToggle.setAttribute('aria-expanded', 'true');
					addToggle.textContent = 'Cancel';
					mountStopForm(addHost, tripId, null, 'create', () => {
						closeAddStopPanel(editor.querySelector('.admin-stops'));
						addToggle.textContent = 'Add stop';
					});
					addPanel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
				};

				addToggle?.addEventListener('click', () => {
					if (!addPanel) return;
					if (!addPanel.hidden) {
						closeAddStopPanel(editor.querySelector('.admin-stops'));
						addToggle.textContent = 'Add stop';
						return;
					}
					openAddStopPanel();
				});

				if (openAddStop) openAddStopPanel();
			}

			function openEditTrip(tripId) {
				closeAddTripPanel();
				const already =
					document.querySelector(`.admin-trip-block[data-id="${CSS.escape(tripId)}"].is-editing`) !=
					null;
				closeAllTripEditors();
				if (already) return;

				const trip = tripsCache.find((t) => t.id === tripId);
				const block = document.querySelector(`.admin-trip-block[data-id="${CSS.escape(tripId)}"]`);
				const editor = block?.querySelector('.admin-row__editor');
				if (!trip || !block || !editor) return;

				block.classList.add('is-editing');
				editor.hidden = false;
				mountTripForm(editor, trip, 'edit', () => closeAllTripEditors());
			}

			function renderTripList() {
				if (!tripListEl) return;
				if (!tripsCache.length) {
					tripListEl.innerHTML = '<p class="empty">No trips yet.</p>';
					return;
				}

				const staging = document.createElement('div');
				staging.innerHTML = tripsCache
					.map((trip) => {
						const hasCover = Boolean(trip.image_url);
						const stopCount =
							typeof trip.stop_count === 'number'
								? trip.stop_count
								: stopsByTrip[trip.id]?.length;
						const stopMeta =
							typeof stopCount === 'number'
								? `${stopCount} stop${stopCount === 1 ? '' : 's'}`
								: '';
						const draftBadge = trip.published
							? ''
							: '<span class="badge badge--draft">draft</span>';
						const metaBits = [stopMeta, draftBadge].filter(Boolean);
						const metaHtml = metaBits.length
							? `<p class="rec-item__meta">${metaBits.join(' · ')}</p>`
							: '';
						const summaryWords = String(trip.summary || '')
							.trim()
							.split(/\s+/)
							.filter(Boolean);
						const summaryTeaser =
							summaryWords.length === 0
								? ''
								: summaryWords.length <= 8
									? summaryWords.join(' ')
									: `${summaryWords.slice(0, 8).join(' ')}…`;
						const media = hasCover
							? `<div class="rec-item__media trip-card__media" aria-hidden="true">
									<img
										src="${escapeHtml(trip.image_url)}"
										alt=""
										width="180"
										height="120"
										loading="lazy"
										decoding="async"
									/>
								</div>`
							: '';
						return `
					<div class="admin-row-block admin-trip-block" data-id="${escapeHtml(trip.id)}">
						<article class="rec-item trip-card admin-trip-card${hasCover ? ' rec-item--with-cover trip-card--with-cover' : ''}">
							${media}
							${metaHtml}
							<h3 class="rec-item__title">${escapeHtml(trip.title)}</h3>
							${summaryTeaser ? `<p class="rec-item__summary">${escapeHtml(summaryTeaser)}</p>` : ''}
							<div class="admin-row__actions">
								<button class="btn btn--primary" type="button" data-action="manage">Manage stops</button>
								<button class="btn btn--ghost" type="button" data-action="edit">Edit</button>
								<button class="btn btn--danger" type="button" data-action="delete">Delete</button>
							</div>
						</article>
						<div class="admin-row__editor admin-expand" hidden></div>
					</div>`;
					})
					.join('');

				tripListEl.replaceChildren(...staging.childNodes);

				tripListEl.querySelectorAll('.admin-trip-block').forEach((block) => {
					const id = block.dataset.id;
					const trip = tripsCache.find((t) => t.id === id);
					if (!trip) return;

					block.querySelector('[data-action="manage"]')?.addEventListener('click', () => {
						void openManageStops(id);
					});
					block.querySelector('[data-action="edit"]')?.addEventListener('click', () => {
						openEditTrip(id);
					});
					block.querySelector('[data-action="delete"]')?.addEventListener('click', async () => {
						if (!confirm(`Delete trip “${trip.title}” and all its stops?`)) return;
						const del = await fetch(`/api/admin/trips/${id}`, { method: 'DELETE' });
						if (!del.ok) {
							setTripStatus('Delete failed.', false);
							return;
						}
						setTripStatus('Trip deleted.');
						closeAllTripEditors();
						closeAddTripPanel();
						await loadTrips();
						await refreshAdminPlanisphere();
					});
				});
			}

			async function loadTrips() {
				if (!tripListEl) return;
				const res = await fetch('/api/admin/trips');
				if (!res.ok) {
					tripListEl.innerHTML = '<p class="form__status form__status--err">Failed to load trips.</p>';
					return;
				}
				tripsCache = await res.json();
				renderTripList();
			}

			addTripToggle?.addEventListener('click', () => {
				if (!addTripPanel) return;
				if (!addTripPanel.hidden) {
					closeAddTripPanel();
					return;
				}
				openAddTripPanel();
			});

			(async () => {
				await loadTrips();
				if (preselect && tripsCache.some((t) => t.id === preselect)) {
					await openManageStops(preselect, { scroll: true });
				}
			})();
		</script>
	)
}
