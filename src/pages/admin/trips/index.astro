---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { env } from 'cloudflare:workers';
import { isAdminAuthorized } from '../../../lib/auth';
import { PLACE_TYPES, PLACE_TYPE_LABELS } from '../../../lib/types';

export const prerender = false;

const authorized = isAdminAuthorized(Astro.request, env);
const preselectId = Astro.url.searchParams.get('trip') || '';
---

<BaseLayout title="Admin · Trips" description="Manage travel trips and itineraries.">
	<header class="section-head">
		<h1>Trips</h1>
		<p>
			Create a trip (for example “Lisbon”), select it, then add itinerary stops with place type and how
			you got there.
		</p>
	</header>

	{
		!authorized ? (
			<p class="form__status form__status--err">
				Unauthorized. Locally set <code>ADMIN_DEV_BYPASS=true</code> in <code>.dev.vars</code>.
			</p>
		) : (
			<>
				<nav class="tabs" aria-label="Admin sections">
					<a href="/admin">Movies & books</a>
					<a href="/admin/trips" aria-current="true">Trips</a>
				</nav>

				<div class="admin-layout admin-layout--trips" id="trips-app" data-preselect={preselectId}>
					<section class="admin-panel">
						<h2 id="trip-form-heading">New trip</h2>
						<form class="form" id="trip-form">
							<input type="hidden" id="trip-id" value="" />
							<label>
								Trip title
								<input type="text" id="trip-title" required maxlength="200" placeholder="Lisbon" />
							</label>
							<label>
								Summary
								<textarea id="trip-summary" required maxlength="4000" />
							</label>
							<label class="checkbox-row">
								<input type="checkbox" id="trip-published" checked />
								Published
							</label>
							<div class="form__actions">
								<button class="btn btn--primary" type="submit">Save trip</button>
								<button class="btn btn--ghost" type="button" id="trip-reset">Clear</button>
								<p class="form__status" id="trip-status" role="status" aria-live="polite" />
							</div>
						</form>

						<h2 class="admin-subhead">All trips</h2>
						<div class="admin-list" id="trip-list">
							<p class="empty">Loading…</p>
						</div>
					</section>

					<section class="admin-panel" id="itinerary-panel">
						<h2 id="itinerary-heading">Itinerary</h2>
						<p class="empty" id="itinerary-empty">Select or create a trip to manage its stops.</p>

						<div id="itinerary-editor" hidden>
							<p class="admin-row__meta" id="selected-trip-label"></p>

							<form class="form" id="stop-form">
								<input type="hidden" id="stop-id" value="" />
								<label>
									Place / destination
									<input type="text" id="stop-place" required maxlength="200" />
								</label>
								<div class="form-grid-2">
									<label>
										Country code (ISO)
										<input
											type="text"
											id="stop-country-code"
											required
											maxlength="2"
											placeholder="PT"
											pattern="[A-Za-z]{2}"
										/>
									</label>
									<label>
										Country name
										<input
											type="text"
											id="stop-country-name"
											required
											maxlength="120"
											placeholder="Portugal"
										/>
									</label>
								</div>
								<label>
									Place type
									<select id="stop-type" required>
										{PLACE_TYPES.map((type) => (
											<option value={type}>{PLACE_TYPE_LABELS[type]}</option>
										))}
									</select>
								</label>
								<label>
									Date & time of visit
									<input type="datetime-local" id="stop-visited" required />
								</label>
								<label>
									How I got there
									<input
										type="text"
										id="stop-transit"
										required
										maxlength="500"
										placeholder="Tram 28, walked from Baixa…"
									/>
								</label>
								<label>
									Notes (optional)
									<textarea id="stop-notes" maxlength="2000" />
								</label>
								<label>
									URL (optional)
									<input type="url" id="stop-url" maxlength="500" placeholder="https://" />
								</label>
								<div class="form-grid-2">
									<label>
										Latitude (map pin)
										<input type="number" id="stop-lat" step="any" min="-90" max="90" placeholder="38.7223" />
									</label>
									<label>
										Longitude (map pin)
										<input type="number" id="stop-lng" step="any" min="-180" max="180" placeholder="-9.1393" />
									</label>
								</div>
								<div class="form__actions">
									<button class="btn btn--ghost" type="button" id="stop-geocode">
										Lookup coordinates
									</button>
								</div>
								<label>
									Sort order
									<input type="number" id="stop-order" min="0" step="1" placeholder="Auto" />
								</label>
								<div class="form__actions">
									<button class="btn btn--primary" type="submit">Save stop</button>
									<button class="btn btn--ghost" type="button" id="stop-reset">Clear stop</button>
									<p class="form__status" id="stop-status" role="status" aria-live="polite" />
								</div>
							</form>

							<h3 class="admin-subhead">Stops</h3>
							<div class="admin-list" id="stop-list">
								<p class="empty">No stops yet.</p>
							</div>
						</div>
					</section>
				</div>
			</>
		)
	}
</BaseLayout>

{
	authorized && (
		<script>
			const app = document.getElementById('trips-app');
			const preselect = app?.dataset.preselect || '';

			const tripForm = document.getElementById('trip-form');
			const tripListEl = document.getElementById('trip-list');
			const tripStatusEl = document.getElementById('trip-status');
			const tripHeading = document.getElementById('trip-form-heading');
			const tripIdField = document.getElementById('trip-id');
			const tripTitleField = document.getElementById('trip-title');
			const tripSummaryField = document.getElementById('trip-summary');
			const tripPublishedField = document.getElementById('trip-published');

			const itineraryEmpty = document.getElementById('itinerary-empty');
			const itineraryEditor = document.getElementById('itinerary-editor');
			const itineraryHeading = document.getElementById('itinerary-heading');
			const selectedTripLabel = document.getElementById('selected-trip-label');
			const stopForm = document.getElementById('stop-form');
			const stopListEl = document.getElementById('stop-list');
			const stopStatusEl = document.getElementById('stop-status');
			const stopIdField = document.getElementById('stop-id');
			const stopPlaceField = document.getElementById('stop-place');
			const stopCountryCodeField = document.getElementById('stop-country-code');
			const stopCountryNameField = document.getElementById('stop-country-name');
			const stopTypeField = document.getElementById('stop-type');
			const stopVisitedField = document.getElementById('stop-visited');
			const stopTransitField = document.getElementById('stop-transit');
			const stopNotesField = document.getElementById('stop-notes');
			const stopUrlField = document.getElementById('stop-url');
			const stopLatField = document.getElementById('stop-lat');
			const stopLngField = document.getElementById('stop-lng');
			const stopOrderField = document.getElementById('stop-order');

			const typeLabels = {
				restaurant: 'Restaurant',
				historic: 'Historic marker',
				attraction: 'Attraction',
				recreational: 'Recreational',
				lodging: 'Lodging',
				other: 'Other',
			};

			let selectedTripId = '';
			let tripsCache = [];
			let stopsCache = [];

			function escapeHtml(value) {
				return String(value)
					.replaceAll('&', '&amp;')
					.replaceAll('<', '&lt;')
					.replaceAll('>', '&gt;')
					.replaceAll('"', '&quot;');
			}

			function setTripStatus(message, ok = true) {
				tripStatusEl.className = `form__status ${ok ? 'form__status--ok' : 'form__status--err'}`;
				tripStatusEl.textContent = message;
			}

			function setStopStatus(message, ok = true) {
				stopStatusEl.className = `form__status ${ok ? 'form__status--ok' : 'form__status--err'}`;
				stopStatusEl.textContent = message;
			}

			function resetTripForm() {
				tripForm.reset();
				tripIdField.value = '';
				tripPublishedField.checked = true;
				tripHeading.textContent = 'New trip';
			}

			function resetStopForm() {
				stopForm.reset();
				stopIdField.value = '';
				stopOrderField.value = '';
			}

			function fillTripForm(trip) {
				tripIdField.value = trip.id;
				tripTitleField.value = trip.title;
				tripSummaryField.value = trip.summary;
				tripPublishedField.checked = trip.published === 1;
				tripHeading.textContent = 'Edit trip';
			}

			function fillStopForm(item) {
				stopIdField.value = item.id;
				stopPlaceField.value = item.place_name;
				stopCountryCodeField.value = item.country_code || '';
				stopCountryNameField.value = item.country_name || '';
				stopTypeField.value = item.place_type;
				stopVisitedField.value = (item.visited_at || '').slice(0, 16);
				stopTransitField.value = item.how_i_got_there;
				stopNotesField.value = item.notes || '';
				stopUrlField.value = item.url || '';
				stopLatField.value = item.lat != null ? String(item.lat) : '';
				stopLngField.value = item.lng != null ? String(item.lng) : '';
				stopOrderField.value = String(item.sort_order);
			}

			function formatVisit(value) {
				if (!value) return '';
				const date = new Date(value.length === 16 ? `${value}:00` : value);
				if (Number.isNaN(date.getTime())) return value;
				return date.toLocaleString(undefined, { dateStyle: 'medium', timeStyle: 'short' });
			}

			async function selectTrip(tripId) {
				selectedTripId = tripId;
				const trip = tripsCache.find((t) => t.id === tripId);
				if (!trip) {
					itineraryEmpty.hidden = false;
					itineraryEditor.hidden = true;
					return;
				}

				itineraryEmpty.hidden = true;
				itineraryEditor.hidden = false;
				itineraryHeading.textContent = `Itinerary · ${trip.title}`;
				selectedTripLabel.textContent = `Editing stops for “${trip.title}”`;
				resetStopForm();
				setStopStatus('');
				await loadStops();
				renderTripList();
				history.replaceState({}, '', `/admin/trips?trip=${encodeURIComponent(tripId)}`);
			}

			function renderTripList() {
				if (!tripsCache.length) {
					tripListEl.innerHTML = '<p class="empty">No trips yet. Create one above.</p>';
					return;
				}

				tripListEl.innerHTML = tripsCache
					.map((trip) => {
						const selected = trip.id === selectedTripId ? ' admin-row--selected' : '';
						return `
					<div class="admin-row${selected}" data-id="${trip.id}">
						<div class="admin-row__title">${escapeHtml(trip.title)}</div>
						<div class="admin-row__meta">
							${trip.published ? 'published' : '<span class="badge badge--draft">draft</span>'} · ${trip.created_at}
						</div>
						<div class="admin-row__actions">
							<button class="btn btn--primary" type="button" data-action="manage">Manage stops</button>
							<button class="btn btn--ghost" type="button" data-action="edit">Edit trip</button>
							<button class="btn btn--danger" type="button" data-action="delete">Delete</button>
						</div>
					</div>`;
					})
					.join('');

				tripListEl.querySelectorAll('.admin-row').forEach((row) => {
					const id = row.dataset.id;
					const trip = tripsCache.find((t) => t.id === id);
					row.querySelector('[data-action="manage"]').addEventListener('click', () => selectTrip(id));
					row.querySelector('[data-action="edit"]').addEventListener('click', () => {
						fillTripForm(trip);
						window.scrollTo({ top: 0, behavior: 'smooth' });
					});
					row.querySelector('[data-action="delete"]').addEventListener('click', async () => {
						if (!confirm(`Delete trip “${trip.title}” and all its stops?`)) return;
						const del = await fetch(`/api/admin/trips/${id}`, { method: 'DELETE' });
						if (!del.ok) {
							setTripStatus('Delete failed.', false);
							return;
						}
						setTripStatus('Trip deleted.');
						if (tripIdField.value === id) resetTripForm();
						if (selectedTripId === id) {
							selectedTripId = '';
							itineraryEmpty.hidden = false;
							itineraryEditor.hidden = true;
							itineraryHeading.textContent = 'Itinerary';
							history.replaceState({}, '', '/admin/trips');
						}
						await loadTrips();
					});
				});
			}

			function renderStops() {
				if (!stopsCache.length) {
					stopListEl.innerHTML = '<p class="empty">No stops yet. Add one above.</p>';
					return;
				}

				stopListEl.innerHTML = stopsCache
					.map(
						(item) => `
					<div class="admin-row" data-id="${item.id}">
						<div class="admin-row__title">${escapeHtml(item.place_name)}</div>
						<div class="admin-row__meta">
							${formatVisit(item.visited_at)} · ${escapeHtml(item.country_name || item.country_code || '')}
							· #${item.sort_order} · ${typeLabels[item.place_type] || item.place_type}
							· ${escapeHtml(item.how_i_got_there)}${
								item.lat != null && item.lng != null ? ' · on map' : ''
							}
						</div>
						<div class="admin-row__actions">
							<button class="btn btn--ghost" type="button" data-action="edit">Edit</button>
							<button class="btn btn--danger" type="button" data-action="delete">Delete</button>
						</div>
					</div>`,
					)
					.join('');

				stopListEl.querySelectorAll('.admin-row').forEach((row) => {
					const id = row.dataset.id;
					const item = stopsCache.find((s) => s.id === id);
					row.querySelector('[data-action="edit"]').addEventListener('click', () => fillStopForm(item));
					row.querySelector('[data-action="delete"]').addEventListener('click', async () => {
						if (!confirm(`Delete “${item.place_name}”?`)) return;
						const del = await fetch(`/api/admin/itinerary/${id}`, { method: 'DELETE' });
						if (!del.ok) {
							setStopStatus('Delete failed.', false);
							return;
						}
						setStopStatus('Stop deleted.');
						if (stopIdField.value === id) resetStopForm();
						await loadStops();
					});
				});
			}

			async function loadTrips() {
				const res = await fetch('/api/admin/trips');
				if (!res.ok) {
					tripListEl.innerHTML = '<p class="form__status form__status--err">Failed to load trips.</p>';
					return;
				}
				tripsCache = await res.json();
				renderTripList();
			}

			async function loadStops() {
				if (!selectedTripId) return;
				const res = await fetch(`/api/admin/trips/${selectedTripId}`);
				if (!res.ok) {
					stopListEl.innerHTML = '<p class="form__status form__status--err">Failed to load stops.</p>';
					return;
				}
				const data = await res.json();
				stopsCache = data.items || [];
				renderStops();
			}

			tripForm.addEventListener('submit', async (event) => {
				event.preventDefault();
				const payload = {
					title: tripTitleField.value,
					summary: tripSummaryField.value,
					published: tripPublishedField.checked,
				};
				const editingId = tripIdField.value;
				const res = await fetch(editingId ? `/api/admin/trips/${editingId}` : '/api/admin/trips', {
					method: editingId ? 'PUT' : 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify(payload),
				});
				const json = await res.json();
				if (!res.ok) {
					setTripStatus(json.error || 'Save failed.', false);
					return;
				}
				setTripStatus(editingId ? 'Trip updated.' : 'Trip created — add stops on the right.');
				resetTripForm();
				await loadTrips();
				await selectTrip(json.id);
			});

			document.getElementById('trip-reset').addEventListener('click', () => {
				resetTripForm();
				setTripStatus('');
			});

			stopForm.addEventListener('submit', async (event) => {
				event.preventDefault();
				if (!selectedTripId) {
					setStopStatus('Select a trip first.', false);
					return;
				}
				const orderRaw = stopOrderField.value.trim();
				const latRaw = stopLatField.value.trim();
				const lngRaw = stopLngField.value.trim();
				const payload = {
					place_name: stopPlaceField.value,
					country_code: stopCountryCodeField.value,
					country_name: stopCountryNameField.value,
					place_type: stopTypeField.value,
					visited_at: stopVisitedField.value,
					how_i_got_there: stopTransitField.value,
					notes: stopNotesField.value || null,
					url: stopUrlField.value || null,
					lat: latRaw === '' ? null : Number(latRaw),
					lng: lngRaw === '' ? null : Number(lngRaw),
				};
				if (orderRaw !== '') payload.sort_order = Number(orderRaw);

				const editingId = stopIdField.value;
				const res = await fetch(
					editingId
						? `/api/admin/itinerary/${editingId}`
						: `/api/admin/trips/${selectedTripId}/itinerary`,
					{
						method: editingId ? 'PUT' : 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify(payload),
					},
				);
				const json = await res.json();
				if (!res.ok) {
					setStopStatus(json.error || 'Save failed.', false);
					return;
				}
				setStopStatus(editingId ? 'Stop updated.' : 'Stop added.');
				resetStopForm();
				await loadStops();
			});

			document.getElementById('stop-reset').addEventListener('click', () => {
				resetStopForm();
				setStopStatus('');
			});

			document.getElementById('stop-geocode').addEventListener('click', async () => {
				const query = stopPlaceField.value.trim();
				if (!query) {
					setStopStatus('Enter a place name first.', false);
					return;
				}
				setStopStatus('Looking up…');
				try {
					const url =
						'https://nominatim.openstreetmap.org/search?format=json&limit=1&q=' +
						encodeURIComponent(query);
					const res = await fetch(url, {
						headers: { Accept: 'application/json' },
					});
					const results = await res.json();
					if (!results.length) {
						setStopStatus('No coordinates found for that place.', false);
						return;
					}
					stopLatField.value = String(Number(results[0].lat));
					stopLngField.value = String(Number(results[0].lon));
					setStopStatus('Coordinates filled — save the stop to keep them.');
				} catch {
					setStopStatus('Lookup failed. Enter lat/lng manually.', false);
				}
			});

			(async () => {
				await loadTrips();
				if (preselect && tripsCache.some((t) => t.id === preselect)) {
					await selectTrip(preselect);
				}
			})();
		</script>
	)
}
