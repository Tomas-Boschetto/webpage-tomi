---
import worldSvg from '../assets/maps/world.svg?raw';

interface Country {
	country_code: string;
	name: string;
	notes: string | null;
}

interface Props {
	countries: Country[];
	title?: string;
	lead?: string;
	id?: string;
}

const {
	countries,
	title = "Where I've been",
	lead,
	id,
} = Astro.props;
const codes = new Set(countries.map((c) => c.country_code.toUpperCase()));
const nameByCode = new Map(countries.map((c) => [c.country_code.toUpperCase(), c.name]));

const resolvedLead =
	lead ??
	(countries.length === 0
		? 'Countries appear here from published trip stops.'
		: `${countries.length} ${countries.length === 1 ? 'country' : 'countries'} from my itinerary stops.`);

function escapeXml(value: string): string {
	return value
		.replace(/&/g, '&amp;')
		.replace(/</g, '&lt;')
		.replace(/>/g, '&gt;')
		.replace(/"/g, '&quot;');
}

function flagUrl(code: string): string {
	return `https://flagcdn.com/w40/${code.toLowerCase()}.png`;
}

/** Mark visited countries and attach titles for hover. */
function highlightWorld(svg: string, visited: Set<string>): string {
	return svg.replace(
		/<path(\s+id="([A-Z]{2})")([^>]*?)\s*\/>/g,
		(full, idAttr: string, code: string, rest: string) => {
			if (!visited.has(code)) return full;
			const label = escapeXml(nameByCode.get(code) || code);
			const attrs = rest.replace(/\sclass="[^"]*"/, '');
			return `<path${idAttr} class="country is-visited"${attrs}><title>${label} (visited)</title></path>`;
		},
	);
}

const mapHtml = highlightWorld(worldSvg, codes);
---

<section class="planisphere" aria-label="Countries visited" id={id}>
	<header class="planisphere__head">
		<h2 class="planisphere__title">{title}</h2>
		<p class="planisphere__lead" data-planisphere-lead>{resolvedLead}</p>
	</header>
	<div
		class="planisphere__map"
		role="img"
		aria-label="World map of visited countries"
		data-planisphere-map
		set:html={mapHtml}
	/>
	<p class="planisphere__credit">Custom SVG planisphere · boundaries from Natural Earth</p>
	<ul class="planisphere__legend" data-planisphere-legend>
		{
			countries.map((c) => (
				<li data-legend-code={c.country_code.toUpperCase()}>
					<img
						class="planisphere__flag"
						src={flagUrl(c.country_code)}
						alt=""
						width="20"
						height="15"
						loading="lazy"
						decoding="async"
					/>
					<strong>{c.name}</strong>
					<span class="planisphere__note"> ({c.country_code})</span>
				</li>
			))
		}
	</ul>
</section>
