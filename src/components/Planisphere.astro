---
interface Country {
	country_code: string;
	name: string;
	notes: string | null;
}

interface Props {
	countries: Country[];
}

const { countries } = Astro.props;
const codes = countries.map((c) => c.country_code.toUpperCase());
---

<section class="planisphere" aria-label="Countries visited">
	<header class="planisphere__head">
		<h2 class="planisphere__title">Where I've been</h2>
		<p class="planisphere__lead">
			{countries.length === 0
				? 'Countries appear here from trip stops you publish.'
				: `${countries.length} ${countries.length === 1 ? 'country' : 'countries'} from your itinerary stops.`}
		</p>
	</header>
	<div
		class="planisphere__map"
		id="planisphere-map"
		data-countries={JSON.stringify(codes)}
		role="img"
		aria-label="World map of visited countries"
	>
	</div>
	{
		countries.length > 0 && (
			<ul class="planisphere__legend">
				{countries.map((c) => (
					<li>
						<span class="planisphere__swatch" aria-hidden="true" />
						<strong>{c.name}</strong>
						<span class="planisphere__note"> ({c.country_code})</span>
					</li>
				))}
			</ul>
		)
	}
</section>

<link
	rel="stylesheet"
	href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
	crossorigin=""
/>
<script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>
<script is:inline>
	(function () {
		var root = document.getElementById('planisphere-map');
		if (!root || !window.L) return;

		var visited = new Set(JSON.parse(root.getAttribute('data-countries') || '[]'));
		// Choropleth only (no basemap tiles).
		var map = window.L.map(root, {
			scrollWheelZoom: false,
			worldCopyJump: true,
			minZoom: 1,
			maxZoom: 6,
			attributionControl: true,
		}).setView([20, 0], 2);

		window.L.control
			.attribution({ prefix: false })
			.addAttribution('Boundaries © Natural Earth')
			.addTo(map);

		var baseStyle = {
			fillColor: '#1a2e28',
			weight: 0.6,
			opacity: 1,
			color: 'rgba(244,240,230,0.18)',
			fillOpacity: 1,
		};
		var visitedStyle = {
			fillColor: '#d9773a',
			weight: 1,
			opacity: 1,
			color: '#e8a574',
			fillOpacity: 1,
		};

		fetch(
			'https://cdn.jsdelivr.net/gh/nvkelso/natural-earth-vector@v5.1.1/geojson/ne_110m_admin_0_countries.geojson',
		)
			.then(function (r) {
				return r.json();
			})
			.then(function (ne) {
				window.L.geoJSON(ne, {
					style: function (feature) {
						var code = String((feature.properties && feature.properties.ISO_A2) || '').toUpperCase();
						return visited.has(code) ? visitedStyle : baseStyle;
					},
					onEachFeature: function (feature, layer) {
						var props = feature.properties || {};
						var code = String(props.ISO_A2 || '').toUpperCase();
						var name = props.NAME || props.ADMIN || code;
						if (visited.has(code)) {
							layer.bindTooltip(name + ' — visited', { sticky: true });
						}
					},
				}).addTo(map);
			})
			.catch(function () {
				root.innerHTML =
					'<p class="empty">World map could not load. Check your network and refresh.</p>';
			});
	})();
</script>
