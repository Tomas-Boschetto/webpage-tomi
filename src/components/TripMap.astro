---
import type { ItineraryItem, TransportMode } from '../lib/types';
import { TRANSPORT_MODE_MAP_STYLE, isTransportMode } from '../lib/types';
import { mapTiles } from '../lib/map-tiles';
import { env } from 'cloudflare:workers';
import { DEFAULT_LOCALE, type Locale } from '../i18n/locales';
import { t, placeTypeLabel, transportModeLabel } from '../i18n';

interface Props {
	items: ItineraryItem[];
	tripTitle: string;
	locale?: Locale;
}

const locale: Locale = Astro.props.locale || DEFAULT_LOCALE;
const { items, tripTitle } = Astro.props;
const mappable = items.filter((i) => i.lat != null && i.lng != null);
const payload = mappable.map((i) => {
	const mode: TransportMode = isTransportMode(i.transport_mode) ? i.transport_mode : 'other';
	return {
		id: i.id,
		name: i.place_name,
		type: placeTypeLabel(locale, i.place_type),
		mode,
		modeLabel: transportModeLabel(locale, mode),
		lat: i.lat as number,
		lng: i.lng as number,
	};
});

const modesUsed = [
	...new Set(
		payload.slice(1).map((s) => s.mode), // segment style uses arrival stop's mode
	),
] as TransportMode[];

const legend = modesUsed.map((mode) => ({
	mode,
	label: transportModeLabel(locale, mode),
	...TRANSPORT_MODE_MAP_STYLE[mode],
}));

const styleByMode = Object.fromEntries(
	Object.entries(TRANSPORT_MODE_MAP_STYLE).map(([mode, style]) => [mode, style]),
);

const googleMapsDirUrl =
	mappable.length > 0
		? `https://www.google.com/maps/dir/${mappable
				.map((i) => `${i.lat},${i.lng}`)
				.join('/')}`
		: '';

const routeSummary = mappable.map((i) => i.place_name).join(' → ');
const routeSummaryId = 'trip-route-summary';
const tiles = mapTiles(env.CARTO_API_KEY);
---

{
	mappable.length > 0 && (
		<div class="trip-map-wrap" aria-label={t(locale, 'trip.map.aria')}>
			<div class="trip-map__header">
				<div>
					<h2 class="trip-map__title">{t(locale, 'trip.map')}</h2>
					<p class="trip-map__lead">{t(locale, 'trip.map.lead')}</p>
				</div>
				<div class="trip-export">
					{googleMapsDirUrl && (
						<a
							class="btn btn--ghost trip-export__btn"
							href={googleMapsDirUrl}
							rel="noopener noreferrer"
							target="_blank"
						>
							{t(locale, 'trip.openMaps')}
							<span class="sr-only"> {t(locale, 'footer.newTab')}</span>
						</a>
					)}
					<button class="btn btn--ghost trip-export__btn" type="button" data-gpx-download>
						{t(locale, 'trip.downloadGpx')}
					</button>
				</div>
			</div>
			<p class="sr-only" id={routeSummaryId}>
				{t(locale, 'trip.route.summary')}: {routeSummary}
			</p>
			<div
				class="trip-map"
				id="trip-map"
				aria-label={t(locale, 'trip.map.canvas')}
				aria-describedby={routeSummaryId}
				data-stops={JSON.stringify(payload)}
				data-styles={JSON.stringify(styleByMode)}
				data-tiles={JSON.stringify({ dark: tiles.dark, light: tiles.light })}
				data-tiles-attr={tiles.attribution}
				data-trip-title={tripTitle}
				data-arrived-by={t(locale, 'trip.arrivedBy', { mode: '{mode}' })}
				data-view-itinerary={t(locale, 'trip.viewInItinerary')}
			/>
			{
				legend.length > 0 && (
					<ul class="trip-map__legend" aria-label={t(locale, 'trip.legend')}>
						{legend.map((entry) => (
							<li>
								<span
									class="trip-map__legend-swatch"
									style={`background:${entry.color};${entry.dashArray ? `background-image:repeating-linear-gradient(90deg,${entry.color} 0 6px,transparent 6px 10px);background-color:transparent;border-bottom:3px solid ${entry.color};` : ''}`}
									aria-hidden="true"
								/>
								{entry.label}
							</li>
						))}
					</ul>
				)
			}
		</div>
	)
}

{
	mappable.length > 0 && (
		<>
			<link
				rel="stylesheet"
				href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
				crossorigin=""
			/>
			<script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin="" />
			<script is:inline>
				(function () {
					var root = document.getElementById('trip-map');
					if (!root || !window.L) return;
					var stops = JSON.parse(root.getAttribute('data-stops') || '[]');
					var styles = JSON.parse(root.getAttribute('data-styles') || '{}');
					var tiles = JSON.parse(root.getAttribute('data-tiles') || '{}');
					var tilesAttr = root.getAttribute('data-tiles-attr') || '';
					var tripTitle = root.getAttribute('data-trip-title') || 'Trip';
					var arrivedByTpl = root.getAttribute('data-arrived-by') || 'Arrived by: {mode}';
					var viewItinerary = root.getAttribute('data-view-itinerary') || 'View in itinerary';
					if (!stops.length) return;

					var preferReduced =
						window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
					var scrollBehavior = preferReduced ? 'auto' : 'smooth';
					var listPanel = document.querySelector('[data-itinerary-list]');
					var hoverId = null;
					var markers = {};
					var casings = [];

					function setMarkerHover(id, on) {
						var marker = markers[id];
						if (!marker || !marker._icon) return;
						marker._icon.classList.toggle('trip-map__marker--hover', on);
						if (on) marker.setZIndexOffset(500);
						else marker.setZIndexOffset(0);
					}

					function clearHover() {
						if (!hoverId) return;
						var prev = document.getElementById('stop-' + hoverId);
						if (prev) prev.classList.remove('itinerary__item--hover');
						setMarkerHover(hoverId, false);
						hoverId = null;
					}

					function setHover(id, fromMap) {
						if (hoverId === id) return;
						clearHover();
						if (!id) return;
						hoverId = id;
						var el = document.getElementById('stop-' + id);
						if (el) {
							el.classList.add('itinerary__item--hover');
							if (fromMap && listPanel) {
								var panelRect = listPanel.getBoundingClientRect();
								var elRect = el.getBoundingClientRect();
								var outOfView =
									elRect.top < panelRect.top || elRect.bottom > panelRect.bottom;
								if (outOfView) {
									el.scrollIntoView({ behavior: scrollBehavior, block: 'nearest' });
								}
							}
						}
						setMarkerHover(id, true);
					}

					function setActive(id) {
						document.querySelectorAll('.itinerary__item--active').forEach(function (node) {
							node.classList.remove('itinerary__item--active');
						});
						var el = document.getElementById('stop-' + id);
						if (!el) return;
						el.classList.add('itinerary__item--active');
						if (!el.hasAttribute('tabindex')) el.setAttribute('tabindex', '-1');
					}

					var map = window.L.map(root, { scrollWheelZoom: false });
					root.removeAttribute('role');
					var schemeMq =
						window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)');
					function currentTileTheme() {
						return schemeMq && schemeMq.matches === false ? 'light' : 'dark';
					}
					var tileLayer = null;
					function applyTiles() {
						var theme = currentTileTheme();
						var spec = tiles[theme] || tiles.dark;
						if (tileLayer) map.removeLayer(tileLayer);
						var group = window.L.layerGroup();
						var maxZoom = spec.maxZoom || 16;
						var layerOpts = { attribution: tilesAttr, maxZoom: maxZoom };
						if (spec.subdomains) layerOpts.subdomains = spec.subdomains;
						window.L.tileLayer(spec.url, layerOpts).addTo(group);
						if (spec.labels) {
							var labelOpts = { maxZoom: maxZoom };
							if (spec.subdomains) labelOpts.subdomains = spec.subdomains;
							window.L.tileLayer(spec.labels, labelOpts).addTo(group);
						}
						tileLayer = group.addTo(map);
						return spec.casing || '#0a1412';
					}
					var casingColor = applyTiles();
					if (schemeMq && schemeMq.addEventListener) {
						schemeMq.addEventListener('change', function () {
							casingColor = applyTiles();
							casings.forEach(function (line) {
								line.setStyle({ color: casingColor });
							});
						});
					}

					var bounds = [];
					stops.forEach(function (stop, index) {
						var marker = window.L.marker([stop.lat, stop.lng], {
							title: stop.name,
						}).addTo(map);
						var arrivedLine =
							index > 0
								? '<br/>' + arrivedByTpl.replace('{mode}', stop.modeLabel)
								: '';
						marker.bindPopup(
							'<strong>' +
								stop.name +
								'</strong><br/>' +
								stop.type +
								arrivedLine +
								'<br/><a href="#stop-' +
								stop.id +
								'">' +
								viewItinerary +
								'</a>',
						);
						marker.on('click', function () {
							setActive(stop.id);
							var el = document.getElementById('stop-' + stop.id);
							if (!el) return;
							el.scrollIntoView({ behavior: scrollBehavior, block: 'center' });
							el.focus({ preventScroll: true });
						});
						marker.on('mouseover', function () {
							setHover(stop.id, true);
						});
						marker.on('mouseout', function () {
							clearHover();
						});
						markers[stop.id] = marker;
						bounds.push([stop.lat, stop.lng]);

						if (index > 0) {
							var prev = stops[index - 1];
							var style = styles[stop.mode] || styles.other || { color: '#9a9588', weight: 3 };
							var pts = [
								[prev.lat, prev.lng],
								[stop.lat, stop.lng],
							];
							var weight = style.weight || 3;
							casings.push(
								window.L.polyline(pts, {
									color: casingColor,
									weight: weight + 4,
									opacity: 0.72,
									lineCap: 'round',
									lineJoin: 'round',
									interactive: false,
								}).addTo(map),
							);
							window.L.polyline(pts, {
								color: style.color,
								weight: weight,
								dashArray: style.dashArray || null,
								opacity: 0.95,
								lineCap: 'round',
								lineJoin: 'round',
							}).addTo(map);
						}
					});

					if (bounds.length === 1) {
						map.setView(bounds[0], 13);
					} else {
						map.fitBounds(bounds, { padding: [40, 40] });
					}

					requestAnimationFrame(function () {
						map.invalidateSize();
					});

					document.querySelectorAll('.itinerary__item[data-stop-id]').forEach(function (el) {
						var id = el.getAttribute('data-stop-id');
						el.addEventListener('pointerenter', function () {
							setHover(id, false);
						});
						el.addEventListener('pointerleave', function () {
							clearHover();
						});
						el.addEventListener('focusin', function () {
							setHover(id, false);
						});
						el.addEventListener('focusout', function (event) {
							if (el.contains(event.relatedTarget)) return;
							clearHover();
						});
					});

					document.querySelectorAll('[data-stop-id]').forEach(function (el) {
						el.addEventListener('click', function (event) {
							var id = el.getAttribute('data-stop-id');
							var marker = markers[id];
							if (!marker) return;
							// Only treat dedicated "show on map" / item clicks; ignore nested links.
							if (event.target.closest && event.target.closest('a[href]')) return;
							setActive(id);
							map.panTo(marker.getLatLng());
							marker.openPopup();
						});
					});

					var gpxBtn = document.querySelector('[data-gpx-download]');
					gpxBtn &&
						gpxBtn.addEventListener('click', function () {
							function esc(s) {
								return String(s)
									.replace(/&/g, '&amp;')
									.replace(/</g, '&lt;')
									.replace(/>/g, '&gt;')
									.replace(/"/g, '&quot;');
							}
							var wpts = stops
								.map(function (stop) {
									return (
										'<wpt lat="' +
										stop.lat +
										'" lon="' +
										stop.lng +
										'"><name>' +
										esc(stop.name) +
										'</name><desc>' +
										esc(stop.type) +
										'</desc></wpt>'
									);
								})
								.join('');
							var trkpts = stops
								.map(function (stop) {
									return '<trkpt lat="' + stop.lat + '" lon="' + stop.lng + '"></trkpt>';
								})
								.join('');
							var gpx =
								'<?xml version="1.0" encoding="UTF-8"?>' +
								'<gpx version="1.1" creator="WebPage Tomi" xmlns="http://www.topografix.com/GPX/1/1">' +
								'<metadata><name>' +
								esc(tripTitle) +
								'</name></metadata>' +
								wpts +
								'<trk><name>' +
								esc(tripTitle) +
								'</name><trkseg>' +
								trkpts +
								'</trkseg></trk></gpx>';
							var blob = new Blob([gpx], { type: 'application/gpx+xml' });
							var url = URL.createObjectURL(blob);
							var a = document.createElement('a');
							a.href = url;
							a.download =
								(String(tripTitle)
									.toLowerCase()
									.replace(/[^a-z0-9]+/g, '-')
									.replace(/^-|-$/g, '') || 'trip') + '.gpx';
							a.click();
							URL.revokeObjectURL(url);
						});
				})();
			</script>
		</>
	)
}
