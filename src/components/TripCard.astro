---
import type { Trip } from '../lib/types';
import { DEFAULT_LOCALE, localizedPath, type Locale } from '../i18n/locales';
import { t } from '../i18n';
import { isUnsplashImageUrl } from '../lib/covers';

interface Props {
	trip: Trip;
	stopCount?: number;
	countryCodes?: string[];
	locale?: Locale;
}

const locale: Locale = Astro.props.locale || DEFAULT_LOCALE;
const { trip, stopCount, countryCodes = [] } = Astro.props;
const hasCover = Boolean(trip.image_url);
const countriesAttr = countryCodes.map((c) => c.toUpperCase()).join(',');
const summaryWords = trip.summary.trim().split(/\s+/).filter(Boolean);
const summaryTeaser =
	summaryWords.length === 0
		? ''
		: summaryWords.length <= 8
			? summaryWords.join(' ')
			: `${summaryWords.slice(0, 8).join(' ')}…`;
const tripHref = localizedPath(locale, `/trips/${trip.id}`);
const stopLabel =
	typeof stopCount === 'number'
		? `${stopCount} ${t(locale, stopCount === 1 ? 'recs.stop' : 'recs.stops')}`
		: '';

const unsplashCredit =
	hasCover &&
	isUnsplashImageUrl(trip.image_url) &&
	Boolean(trip.cover_credit_name?.trim());
const photographerName = trip.cover_credit_name?.trim() || '';
const photographerHref =
	trip.cover_credit_profile_url?.trim() || 'https://unsplash.com/?utm_source=tomasboschetto&utm_medium=referral';
const unsplashHref =
	trip.cover_credit_photo_url?.trim() || 'https://unsplash.com/?utm_source=tomasboschetto&utm_medium=referral';
---

<article
	class:list={['rec-item', 'trip-card', hasCover && 'rec-item--with-cover', hasCover && 'trip-card--with-cover']}
	data-trip-card
	data-countries={countriesAttr}
>
	{
		hasCover && (
			<div class="rec-item__media trip-card__media">
				<img
					src={trip.image_url!}
					alt={t(locale, 'trip.photoFor', { title: trip.title })}
					width="180"
					height="120"
					loading="lazy"
					decoding="async"
				/>
				{
					unsplashCredit && (
						<p class="trip-card__credit">
							{t(locale, 'recs.attr.photoBy')}{' '}
							<a href={photographerHref} rel="noopener noreferrer" target="_blank">
								{photographerName}
								<span class="sr-only"> {t(locale, 'footer.newTab')}</span>
							</a>{' '}
							{t(locale, 'recs.attr.on')}{' '}
							<a href={unsplashHref} rel="noopener noreferrer" target="_blank">
								Unsplash
								<span class="sr-only"> {t(locale, 'footer.newTab')}</span>
							</a>
						</p>
					)
				}
			</div>
		)
	}
	{typeof stopCount === 'number' && <p class="rec-item__meta">{stopLabel}</p>}
	<h3 class="rec-item__title">
		<a class="rec-item__title-link" href={tripHref}>{trip.title}</a>
	</h3>
	{summaryTeaser && <p class="rec-item__summary">{summaryTeaser}</p>}
	<a class="rec-item__link" href={tripHref}>
		{t(locale, 'trip.viewItinerary')}
		<span class="sr-only">{t(locale, 'recs.srForTitle', { title: trip.title })}</span>
	</a>
</article>
