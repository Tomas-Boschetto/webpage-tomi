---
import '../styles/global.css';
import { env } from 'cloudflare:workers';
import { absoluteUrl, getSiteUrl, localizedCanonicalPath } from '../lib/site';
import {
	DEFAULT_LOCALE,
	LOCALES,
	LOCALE_LABELS,
	OG_LOCALE,
	localizedPath,
	stripLocalePrefix,
	type Locale,
} from '../i18n/locales';
import { t } from '../i18n';

interface Props {
	title?: string;
	description?: string;
	/** Absolute or site-relative image for Open Graph / Twitter. */
	image?: string;
	/** Override robots when a page should stay out of search (e.g. admin). */
	robots?: string;
	/** Optional JSON-LD object(s) for structured data. */
	jsonLd?: Record<string, unknown> | Record<string, unknown>[];
	/** Active UI locale (defaults from URL / en). */
	locale?: Locale;
}

const siteName = env.SITE_NAME || 'Tomas Boschetto';
const linkedIn = env.LINKEDIN_URL || 'https://www.linkedin.com/in/tomasboschetto/';
const siteUrl = getSiteUrl(env);
const locale: Locale =
	Astro.props.locale ||
	(Astro.currentLocale as Locale | undefined) ||
	DEFAULT_LOCALE;
const {
	title = siteName,
	description = t(locale, 'layout.defaultDescription'),
	image = '/images/hero-ar.jpg',
	robots = 'index, follow',
	jsonLd,
} = Astro.props;
const pageTitle = title === siteName ? siteName : `${title} · ${siteName}`;
const path = Astro.url.pathname;
const pathNoLocale = stripLocalePrefix(path);
const search = Astro.url.search;
const canonical = absoluteUrl(siteUrl, localizedCanonicalPath(locale, path, Astro.url.searchParams));
const ogImage = absoluteUrl(siteUrl, image);
const year = new Date().getFullYear();
const jsonLdBlocks = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];

const homeHref = localizedPath(locale, '/');
const aboutHref = localizedPath(locale, '/about');
const recsBase = localizedPath(locale, '/recommendations');
const recsTravelHref = `${recsBase}?type=travel`;
const recsBooksHref = `${recsBase}?type=book`;
const recsMoviesHref = `${recsBase}?type=movie`;
const contactHref = localizedPath(locale, '/contact');
const disclaimerHref = localizedPath(locale, '/disclaimer');

const recType = Astro.url.searchParams.get('type');
const isHome = pathNoLocale === '/' || pathNoLocale === '';
const isAbout = pathNoLocale.startsWith('/about');
const isRecs = pathNoLocale.startsWith('/recommendations') || pathNoLocale.startsWith('/trips');
const isTravel = pathNoLocale.startsWith('/trips') || (isRecs && recType === 'travel');
const isBooks = pathNoLocale.startsWith('/recommendations') && recType === 'book';
const isMovies = pathNoLocale.startsWith('/recommendations') && recType === 'movie';
const isContact = pathNoLocale.startsWith('/contact');
---

<!doctype html>
<html lang={locale}>
	<head>
		<meta charset="utf-8" />
		<link rel="icon" href="/site-mark-32.png" type="image/png" sizes="32x32" />
		<link rel="icon" href="/site-mark.svg" type="image/svg+xml" />
		<link rel="apple-touch-icon" href="/site-mark-180.png" />
		<link rel="shortcut icon" href="/site-mark.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="robots" content={robots} />
		<link rel="canonical" href={canonical} />

		{
			LOCALES.map((loc) => (
				<link
					rel="alternate"
					hreflang={loc}
					href={absoluteUrl(siteUrl, localizedCanonicalPath(loc, path, Astro.url.searchParams))}
				/>
			))
		}
		<link
			rel="alternate"
			hreflang="x-default"
			href={absoluteUrl(
				siteUrl,
				localizedCanonicalPath(DEFAULT_LOCALE, path, Astro.url.searchParams),
			)}
		/>

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={siteName} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:locale" content={OG_LOCALE[locale]} />
		{
			LOCALES.filter((l) => l !== locale).map((loc) => (
				<meta property="og:locale:alternate" content={OG_LOCALE[loc]} />
			))
		}

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />

		{
			jsonLdBlocks.map((block) => (
				<script type="application/ld+json" set:html={JSON.stringify(block)} />
			))
		}

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400..700;1,6..72,400..700&family=Public+Sans:ital,wght@0,400..700;1,400..700&display=swap"
			rel="stylesheet"
		/>
		<title>{pageTitle}</title>
	</head>
	<body>
		<a class="skip-link" href="#main">{t(locale, 'skip.main')}</a>
		<header class="site-header">
			<div class="site-header__inner">
				<a class="brand" href={homeHref}>{siteName}</a>
				<nav class="nav" aria-label={t(locale, 'nav.primary')}>
					<a href={homeHref} aria-current={isHome ? 'page' : undefined}>{t(locale, 'nav.home')}</a>
					<a href={aboutHref} aria-current={isAbout ? 'page' : undefined}
						>{t(locale, 'nav.about')}</a
					>
					<div class="nav-menu">
						<details class="nav-menu__details" data-nav-menu>
							<summary
								class="nav-menu__summary"
								aria-current={isRecs ? 'true' : undefined}
							>
								{t(locale, 'nav.recommendations')}
							</summary>
							<div class="nav-menu__panel" role="navigation" aria-label={t(locale, 'nav.recsMenu')}>
								<a href={recsTravelHref} aria-current={isTravel ? 'page' : undefined}
									>{t(locale, 'recs.travel')}</a
								>
								<a href={recsBooksHref} aria-current={isBooks ? 'page' : undefined}
									>{t(locale, 'recs.books')}</a
								>
								<a href={recsMoviesHref} aria-current={isMovies ? 'page' : undefined}
									>{t(locale, 'recs.movies')}</a
								>
							</div>
						</details>
					</div>
					<a href={contactHref} aria-current={isContact ? 'page' : undefined}
						>{t(locale, 'nav.contact')}</a
					>
				</nav>
				<label class="lang-switch">
					<span class="sr-only">{t(locale, 'nav.language')}</span>
					<select
						class="lang-switch__select"
						data-lang-switch
						aria-label={t(locale, 'nav.language')}
						onchange="window.location.assign(this.value)"
					>
						{
							LOCALES.map((loc) => {
								const href =
									(pathNoLocale === '/'
										? localizedPath(loc, '/')
										: localizedPath(loc, pathNoLocale)) + search;
								return (
									<option value={href} selected={loc === locale} lang={loc}>
										{LOCALE_LABELS[loc]}
									</option>
								);
							})
						}
					</select>
				</label>
			</div>
		</header>
		<main class="site-main" id="main" tabindex="-1">
			<slot />
		</main>
		<footer class="site-footer">
			<div class="site-footer__inner">
				<p class="site-footer__copy">
					© {year}. {siteName}. {t(locale, 'footer.tagline')}
				</p>
				<nav class="site-footer__links" aria-label={t(locale, 'footer.nav')}>
					<a href={linkedIn} rel="noopener noreferrer" target="_blank"
						>{t(locale, 'footer.linkedin')}<span class="sr-only">
							{' '}
							{t(locale, 'footer.newTab')}</span
						></a
					>
					<a href={contactHref}>{t(locale, 'footer.contact')}</a>
					<a href={disclaimerHref}>{t(locale, 'footer.disclaimer')}</a>
				</nav>
			</div>
		</footer>
		<script>
			document.querySelector('.skip-link')?.addEventListener('click', (event) => {
				const main = document.getElementById('main');
				if (!(main instanceof HTMLElement)) return;
				event.preventDefault();
				main.focus({ preventScroll: true });
				const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
				main.scrollIntoView({ block: 'start', behavior: reduceMotion ? 'auto' : 'smooth' });
				history.replaceState(null, '', `${location.pathname}${location.search}#main`);
			});
			document.querySelector('[data-lang-switch]')?.addEventListener('change', (event) => {
				const select = event.currentTarget;
				if (select instanceof HTMLSelectElement && select.value) {
					window.location.assign(select.value);
				}
			});
			document.querySelectorAll('[data-nav-menu]').forEach((menu) => {
				if (!(menu instanceof HTMLDetailsElement)) return;
				document.addEventListener('click', (event) => {
					if (!menu.open) return;
					if (event.target instanceof Node && menu.contains(event.target)) return;
					menu.open = false;
				});
				document.addEventListener('keydown', (event) => {
					if (event.key === 'Escape') menu.open = false;
				});
			});
		</script>
	</body>
</html>
