---
import '../styles/global.css';
import { env } from 'cloudflare:workers';
import { absoluteUrl, getSiteUrl } from '../lib/site';

interface Props {
	title?: string;
	description?: string;
	/** Absolute or site-relative image for Open Graph / Twitter. */
	image?: string;
	/** Override robots when a page should stay out of search (e.g. admin). */
	robots?: string;
	/** Optional JSON-LD object(s) for structured data. */
	jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const siteName = env.SITE_NAME || 'Tomas Boschetto';
const linkedIn = env.LINKEDIN_URL || 'https://www.linkedin.com/in/tomasboschetto/';
const siteUrl = getSiteUrl(env);
const {
	title = siteName,
	description = 'Personal movie, book, and travel recommendations.',
	image = '/images/hero-ar.jpg',
	robots = 'index, follow',
	jsonLd,
} = Astro.props;
const pageTitle = title === siteName ? siteName : `${title} · ${siteName}`;
const path = Astro.url.pathname;
const canonical = absoluteUrl(siteUrl, path === '/' ? '/' : path.replace(/\/+$/, '') || '/');
const ogImage = absoluteUrl(siteUrl, image);
const year = new Date().getFullYear();
const jsonLdBlocks = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" href="/site-mark-32.png" type="image/png" sizes="32x32" />
		<link rel="icon" href="/site-mark.svg" type="image/svg+xml" />
		<link rel="apple-touch-icon" href="/site-mark-180.png" />
		<link rel="shortcut icon" href="/site-mark.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="robots" content={robots} />
		<link rel="canonical" href={canonical} />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={siteName} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:locale" content="en_US" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />

		{
			jsonLdBlocks.map((block) => (
				<script type="application/ld+json" set:html={JSON.stringify(block)} />
			))
		}

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,600;1,9..40,400&family=Literata:opsz,wght@7..72,400;7..72,600&family=Syne:wght@700;800&display=swap"
			rel="stylesheet"
		/>
		<title>{pageTitle}</title>
	</head>
	<body>
		<header class="site-header">
			<div class="site-header__inner">
				<a class="brand" href="/">{siteName}</a>
				<nav class="nav" aria-label="Primary">
					<a href="/" aria-current={path === '/' ? 'page' : undefined}>Home</a>
					<a href="/about" aria-current={path.startsWith('/about') ? 'page' : undefined}
						>About me</a
					>
					<a
						href="/recommendations"
						aria-current={path.startsWith('/recommendations') ? 'page' : undefined}
						>Recommendations</a
					>
					<a href="/contact" aria-current={path.startsWith('/contact') ? 'page' : undefined}
						>Contact</a
					>
				</nav>
			</div>
		</header>
		<main class="site-main" id="main">
			<slot />
		</main>
		<footer class="site-footer">
			<div class="site-footer__inner">
				<p class="site-footer__copy">
					© {year}. {siteName}. Out there, and elsewhere in stories
				</p>
				<nav class="site-footer__links" aria-label="Footer">
					<a href={linkedIn} rel="noopener noreferrer" target="_blank">Follow on LinkedIn</a>
					<a href="/contact">Get in touch</a>
				</nav>
			</div>
		</footer>
	</body>
</html>
